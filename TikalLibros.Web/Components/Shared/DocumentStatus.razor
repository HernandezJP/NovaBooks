@* Etiqueta de estado de documentos (órdenes, recepciones, pedidos, ventas) y existencias. *@

<span class="status-pill @CssClass">@Text</span>

@code {
    /// <summary>Código de estado (BORRADOR, EMITIDA, AGOTADO…).</summary>
    [Parameter, EditorRequired]
    public string Code { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    private string CssClass => Code switch
    {
        "RECIBIDA" or "PROCESADA" or "NORMAL" or "FACTURADO" or "PAGADA" => "status-pill--active",
        "EMITIDA" or "SOBRE_MAXIMO" or "RESERVADO" or "CREDITO" => "status-pill--info",
        "PARCIAL" or "BAJO_MINIMO" or "POR_APROBAR" or "DEVUELTA" => "status-pill--warning",
        "CANCELADA" or "ANULADA" or "AGOTADO" or "CANCELADO" or "RECHAZADO" or "VENCIDO" => "status-pill--danger",
        _ => "status-pill--neutral"
    };
}
