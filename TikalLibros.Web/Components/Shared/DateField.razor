@* Campo de fecha de toda la aplicación: formato dd/MM/yyyy. Al escribir
   solo se aceptan dígitos y las barras se colocan solas (tikal.js, clase
   tl-filter-date); también puede elegirse en el calendario. *@
@using System.Globalization

<MudDatePicker Date="_value" DateChanged="OnChanged" Text="@_text" TextChanged="OnTextChanged" Label="@Label" HelperText="@HelperText"
               DateFormat="dd/MM/yyyy" Culture="Culture" Editable="!ReadOnly"
               Placeholder="dd/mm/aaaa"
               Clearable="Clearable" ReadOnly="ReadOnly" Disabled="Disabled"
               Error="@(Error || _textError is not null)" ErrorText="@(_textError ?? ErrorText)" Required="Required" RequiredError="@RequiredError"
               Variant="Variant.Outlined" Margin="Margin.Dense" Class="@($"tl-filter-date {Class}")" />

@* El rango (MinDate/MaxDate) lo valida este componente y no el calendario:
   MudDatePicker descarta en silencio las fechas escritas fuera de rango, y
   así el usuario ve el motivo. *@

@code {
    private static readonly CultureInfo Culture = CultureInfo.GetCultureInfo("es-GT");

    [Parameter]
    public DateTime? Value { get; set; }

    [Parameter]
    public EventCallback<DateTime?> ValueChanged { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? HelperText { get; set; }

    [Parameter]
    public DateTime? MinDate { get; set; }

    [Parameter]
    public DateTime? MaxDate { get; set; }

    [Parameter]
    public bool Clearable { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Error { get; set; }

    [Parameter]
    public string? ErrorText { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public string RequiredError { get; set; } = "La fecha es obligatoria.";

    [Parameter]
    public string? Class { get; set; }

    private string? _textError;

    // Valor propio del componente: al cambiar la fecha, este componente se
    // vuelve a dibujar antes que el formulario; si usara Value directamente,
    // el calendario recibiría el valor anterior y borraría lo escrito.
    private DateTime? _value;
    private DateTime? _lastValueParameter;
    private string? _text;

    protected override void OnParametersSet()
    {
        if (Value != _lastValueParameter)
        {
            _lastValueParameter = Value;
            _value = Value;
            _text = Value?.ToString("dd/MM/yyyy", Culture);
        }
    }

    private Task OnChanged(DateTime? value)
    {
        _value = value;
        _lastValueParameter = value;
        _text = value?.ToString("dd/MM/yyyy", Culture);
        _textError = value is { } date ? RangeError(date) : null;
        return ValueChanged.InvokeAsync(value);
    }

    private string? RangeError(DateTime date) =>
        MinDate is { } min && date.Date < min.Date ? $"La fecha no puede ser anterior al {min:dd/MM/yyyy}."
        : MaxDate is { } max && date.Date > max.Date ? $"La fecha no puede ser posterior al {max:dd/MM/yyyy}."
        : null;

    /// <summary>Explica por qué no se aceptó lo escrito (fecha inexistente o fuera de rango).</summary>
    private void OnTextChanged(string? text)
    {
        // El texto se devuelve al calendario: si TextChanged se escucha sin
        // enlazar Text, MudBlazor lo reinicia a vacío al volver a dibujar y la
        // fecha elegida en el calendario no aparece en el campo.
        _text = text;

        if (string.IsNullOrWhiteSpace(text))
        {
            _textError = null;
            return;
        }

        if (!DateTime.TryParseExact(text, "dd/MM/yyyy", Culture, DateTimeStyles.None, out DateTime date))
        {
            _textError = "Fecha no válida. Use el formato dd/mm/aaaa con una fecha que exista.";
        }
        else
        {
            _textError = RangeError(date);
        }
    }
}
