@page "/compras"
@attribute [RequirePermission(AppPermissions.PurchasesView)]
@implements IDisposable
@using TikalLibros.Application.Common
@using TikalLibros.Application.DTOs.Common
@using TikalLibros.Application.DTOs.Purchasing
@inject PurchasesApi PurchasesApi
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>Órdenes de compra | Tikal Libros</PageTitle>

<PageHeader Title="Órdenes de compra"
            Description="Pedidos a proveedores: se emiten, se reciben (parcial o totalmente) y al recibir se actualiza el inventario."
            Breadcrumbs="_breadcrumbs">
    <Actions>
        @if (CanDirect)
        {
            <MudButton Href="/compras/directa" Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.MoveToInbox">
                Compra directa
            </MudButton>
        }
        @if (Session.HasPermission(AppPermissions.PurchasesCreate))
        {
            <MudButton Href="/compras/nueva" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AddShoppingCart">
                Nueva orden
            </MudButton>
        }
    </Actions>
</PageHeader>

<div class="stat-grid">
    @foreach ((string code, string label, string tint, string icon) in Cards)
    {
        <StatCard Tint="@tint" Icon="@icon" Label="@label"
                  Loading="!_counts.ContainsKey(code) && _countError is null"
                  Value="@(_counts.TryGetValue(code, out int count) ? count.ToString("N0") : null)" Error="@_countError" />
    }
</div>

<Panel Title="Órdenes" Subtitle="Busque por número, proveedor o título de un libro." Icon="@Icons.Material.Outlined.ShoppingCart">
    <div class="list-toolbar">
        <MudTextField @bind-Value="_search" Placeholder="Número, proveedor o título"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                      DebounceInterval="400" OnDebounceIntervalElapsed="SearchAsync"
                      OnClearButtonClick="ClearSearchAsync" MaxLength="100"
                      aria-label="Buscar órdenes" Class="list-toolbar__search tl-filter-plain" />

        <MudSelect T="string" Value="_status" ValueChanged="StatusChangedAsync" Label="Estado"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="list-toolbar__filter">
            <MudSelectItem T="string" Value="@string.Empty">Todos</MudSelectItem>
            @foreach (CatalogOptionResponse status in _statuses)
            {
                <MudSelectItem T="string" Value="status.Code">@status.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int?" Value="_supplierId" ValueChanged="SupplierChangedAsync" Label="Proveedor"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" Class="list-toolbar__filter">
            @foreach (CatalogOptionResponse supplier in _suppliers)
            {
                <MudSelectItem T="int?" Value="supplier.Id">@supplier.Name</MudSelectItem>
            }
        </MudSelect>
    </div>

    @if (_loading && _page is null)
    {
        <LoadingState />
    }
    else if (_error is not null)
    {
        <ErrorState Title="No fue posible cargar las órdenes" Message="@_error" OnRetry="LoadAsync" />
    }
    else if (_page is { Items.Count: 0 })
    {
        <EmptyState Icon="@Icons.Material.Outlined.ShoppingCart" Title="No hay órdenes de compra"
                    Message="@(HasFilters ? "Ajuste la búsqueda o los filtros." : "Cree la primera orden con el botón Nueva orden.")" />
    }
    else if (_page is not null)
    {
        <div class="table-scroll">
            <MudTable Items="_page.Items" Hover="true" Dense="true" Elevation="0" Loading="_loading"
                      Breakpoint="Breakpoint.None" Class="tl-table tl-table--clickable"
                      OnRowClick="@((TableRowClickEventArgs<PurchaseOrderListItemResponse> args) => Navigation.NavigateTo($"/compras/{args.Item!.Id}"))">
                <HeaderContent>
                    <MudTh>Orden</MudTh>
                    <MudTh>Proveedor</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh Class="col-optional">Recibido</MudTh>
                    <MudTh Class="col-optional">Entrega</MudTh>
                    <MudTh Class="text-right">Total</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <div class="cell-primary">@context.Number</div>
                        <div class="cell-secondary">@context.IssueDate.ToLocalTime().ToString("dd/MM/yyyy") · @context.Lines libro(s)</div>
                    </MudTd>
                    <MudTd>
                        <div class="cell-primary">@context.SupplierName</div>
                        <div class="cell-secondary">@context.SupplierCode</div>
                    </MudTd>
                    <MudTd><DocumentStatus Code="@context.StatusCode" Text="@context.Status" /></MudTd>
                    <MudTd Class="col-optional progress-cell">
                        <MudProgressLinear Value="@Percent(context)" Color="Color.Success" Rounded="true" Size="Size.Small" />
                        <div class="cell-secondary">@context.ReceivedUnits.ToString("N0") de @context.OrderedUnits.ToString("N0")</div>
                    </MudTd>
                    <MudTd Class="col-optional cell-nowrap">@(context.ExpectedDate?.ToString("dd/MM/yyyy") ?? "—")</MudTd>
                    <MudTd Class="number">@context.CurrencySymbol @context.Total.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>
        </div>

        <ListPager Page="_page.Page" PageSize="_page.PageSize" TotalItems="_page.TotalItems"
                   TotalPages="_page.TotalPages" PageChanged="PageChangedAsync" />
    }
</Panel>

@code {
    private const int PageSize = 10;

    private static readonly (string Code, string Label, string Tint, string Icon)[] Cards =
    [
        (PurchaseOrderStatus.Draft, "Borradores", "sand", Icons.Material.Outlined.EditNote),
        (PurchaseOrderStatus.Issued, "Emitidas por recibir", "sky", Icons.Material.Outlined.LocalShipping),
        (PurchaseOrderStatus.Partial, "Recibidas parcialmente", "peach", Icons.Material.Outlined.HourglassBottom)
    ];

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Inicio", "/"),
        new("Compras", null, disabled: true),
        new("Órdenes de compra", null, disabled: true)
    ];

    [SupplyParameterFromQuery(Name = "proveedor")]
    public int? SupplierFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "estado")]
    public string? StatusFromQuery { get; set; }

    private PagedResponse<PurchaseOrderListItemResponse>? _page;
    private IReadOnlyCollection<CatalogOptionResponse> _statuses = [];
    private IReadOnlyCollection<CatalogOptionResponse> _suppliers = [];
    private readonly Dictionary<string, int> _counts = [];
    private string? _countError;
    private string? _search;
    private string _status = string.Empty;
    private int? _supplierId;
    private int _pageNumber = 1;
    private bool _loading;
    private string? _error;
    private CancellationTokenSource? _loadCancellation;

    private bool CanDirect =>
        Session.HasPermission(AppPermissions.PurchasesCreate) &&
        Session.HasPermission(AppPermissions.PurchasesApprove) &&
        Session.HasPermission(AppPermissions.PurchasesReceive);

    private bool HasFilters => !string.IsNullOrWhiteSpace(_search) || _status.Length > 0 || _supplierId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        _supplierId = SupplierFromQuery;
        _status = StatusFromQuery?.ToUpperInvariant() ?? string.Empty;

        Task load = LoadAsync();
        Task counts = LoadCountsAsync();
        ApiResult<PurchaseOrderCatalogsResponse> catalogs = await PurchasesApi.GetCatalogsAsync();
        _statuses = catalogs.Data?.Statuses ?? [];
        _suppliers = catalogs.Data?.Suppliers ?? [];
        await Task.WhenAll(load, counts);
    }

    private async Task LoadCountsAsync()
    {
        foreach ((string code, _, _, _) in Cards)
        {
            ApiResult<PagedResponse<PurchaseOrderListItemResponse>> result =
                await PurchasesApi.GetPagedAsync(new PurchaseOrderQuery { Status = code, PageSize = 1 });

            if (!result.Succeeded)
            {
                _countError = result.Message;
                return;
            }

            _counts[code] = result.Data!.TotalItems;
        }
    }

    private async Task LoadAsync()
    {
        _loadCancellation?.Cancel();
        _loadCancellation = new CancellationTokenSource();
        CancellationToken token = _loadCancellation.Token;

        _loading = true;
        _error = null;

        ApiResult<PagedResponse<PurchaseOrderListItemResponse>> result = await PurchasesApi.GetPagedAsync(
            new PurchaseOrderQuery
            {
                Search = _search,
                Status = _status,
                SupplierId = _supplierId,
                Page = _pageNumber,
                PageSize = PageSize
            },
            token);

        if (token.IsCancellationRequested)
        {
            return;
        }

        if (result.Succeeded)
        {
            _page = result.Data;
        }
        else
        {
            _error = result.Message;
        }

        _loading = false;
    }

    private static double Percent(PurchaseOrderListItemResponse order) =>
        order.OrderedUnits == 0 ? 0 : (double)(order.ReceivedUnits / order.OrderedUnits * 100);

    private Task SearchAsync(string? _)
    {
        _pageNumber = 1;
        return LoadAsync();
    }

    private Task ClearSearchAsync(MouseEventArgs _)
    {
        _search = null;
        _pageNumber = 1;
        return LoadAsync();
    }

    private Task StatusChangedAsync(string value)
    {
        _status = value;
        _pageNumber = 1;
        return LoadAsync();
    }

    private Task SupplierChangedAsync(int? value)
    {
        _supplierId = value;
        _pageNumber = 1;
        return LoadAsync();
    }

    private Task PageChangedAsync(int page)
    {
        _pageNumber = page;
        return LoadAsync();
    }

    public void Dispose()
    {
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
    }
}
