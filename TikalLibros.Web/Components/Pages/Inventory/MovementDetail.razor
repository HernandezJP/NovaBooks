@page "/inventario/movimientos/{Id:int}"
@attribute [RequirePermission(AppPermissions.InventoryViewMovements)]
@using TikalLibros.Application.DTOs.Inventory
@inject InventoryApi InventoryApi

<PageTitle>@(_movement?.Number ?? "Movimiento") | Tikal Libros</PageTitle>

<PageHeader Title="@($"Movimiento {_movement?.Number}")" Breadcrumbs="_breadcrumbs" Description="@_movement?.Type">
    <Actions>
        @if (_movement is not null)
        {
            <DocumentStatus Code="@(_movement.Annulled ? "ANULADA" : "PROCESADA")" Text="@(_movement.Annulled ? "Anulado" : "Procesado")" />
        }
    </Actions>
</PageHeader>

@if (_loadError is not null)
{
    <div class="panel"><ErrorState Title="No fue posible cargar el movimiento" Message="@_loadError" OnRetry="LoadAsync" /></div>
}
else if (_movement is null)
{
    <div class="panel"><LoadingState Rows="5" /></div>
}
else
{
    <div class="layout-stack">
        <div class="panel">
            <dl class="detail-list">
                <dt>Fecha</dt>
                <dd>@_movement.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                @if (_movement.SourceWarehouse is not null && _movement.TargetWarehouse is not null)
                {
                    <dt>Origen → destino</dt>
                    <dd>
                        @_movement.SourceWarehouse → @_movement.TargetWarehouse ·
                        <a href="@($"/inventario/traslados/{_movement.Id}")">ver traslado</a>
                    </dd>
                }
                else
                {
                    <dt>@(_movement.Nature >= 0 ? "Almacén destino" : "Almacén origen")</dt>
                    <dd>@(_movement.TargetWarehouse ?? _movement.SourceWarehouse)</dd>
                }
                <dt>Documento</dt>
                <dd>
                    @(_movement.DocumentReference ?? "—")
                    @if (_movement.ReceptionId is int reception)
                    {
                        <text> · </text><a href="@($"/recepciones/{reception}")">ver recepción</a>
                    }
                </dd>
                <dt>Registró</dt>
                <dd>@(_movement.Employee ?? "—")</dd>
                @if (_movement.Annulled)
                {
                    <dt>Anulación</dt>
                    <dd>@_movement.AnnulledAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @_movement.AnnulmentReason</dd>
                }
                @if (!string.IsNullOrWhiteSpace(_movement.Notes))
                {
                    <dt>Observaciones</dt>
                    <dd><p class="notes-block">@_movement.Notes</p></dd>
                }
            </dl>
            <div class="form-actions">
                <MudButton Href="/inventario/movimientos" Variant="Variant.Text">Volver</MudButton>
            </div>
        </div>

        <Panel Title="Libros" Icon="@Icons.Material.Outlined.MenuBook">
            <div class="table-scroll">
                <MudTable Items="_movement.Lines" Dense="true" Elevation="0" Breakpoint="Breakpoint.None" Class="tl-table">
                    <HeaderContent>
                        <MudTh>Libro</MudTh>
                        <MudTh Class="col-optional">Lote</MudTh>
                        <MudTh Class="text-right">Cantidad</MudTh>
                        @if (_movement.Lines.Any(line => line.UnitCost is not null))
                        {
                            <MudTh Class="text-right col-optional">Costo unit.</MudTh>
                            <MudTh Class="text-right col-optional">Costo total</MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div class="cell-primary"><a href="@($"/inventario/kardex?libro={context.BookId}")">@context.Title</a></div>
                            <div class="cell-secondary">@context.BookCode</div>
                        </MudTd>
                        <MudTd Class="col-optional cell-nowrap">@(context.LotNumber ?? "—")</MudTd>
                        <MudTd Class="@($"number {(_movement.Nature > 0 ? "qty-in" : "qty-out")}")">@context.Quantity.ToString("N0")</MudTd>
                        @if (context.UnitCost is not null)
                        {
                            <MudTd Class="number col-optional">@context.UnitCost?.ToString("N2")</MudTd>
                            <MudTd Class="number col-optional">@context.TotalCost?.ToString("N2")</MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            </div>
        </Panel>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Inicio", "/"),
        new("Movimientos", "/inventario/movimientos"),
        new("Detalle", null, disabled: true)
    ];

    private MovementResponse? _movement;
    private string? _loadError;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loadError = null;
        ApiResult<MovementResponse> result = await InventoryApi.GetMovementAsync(Id);
        _movement = result.Data;
        _loadError = result.Succeeded ? null : result.Message;
    }
}
