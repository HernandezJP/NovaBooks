@page "/inventario/alertas"
@attribute [RequirePermission(AppPermissions.InventoryView)]
@using TikalLibros.Application.DTOs.Common
@using TikalLibros.Application.DTOs.Inventory
@inject InventoryApi InventoryApi
@inject SessionState Session

<PageTitle>Alertas de inventario | Tikal Libros</PageTitle>

<PageHeader Title="Alertas de inventario"
            Description="Libros agotados, bajo su mínimo o sobre su máximo, con la cantidad sugerida a pedir."
            Breadcrumbs="_breadcrumbs">
    <Actions>
        @if (Session.HasPermission(AppPermissions.PurchasesCreate) && _alerts?.Any(alert => alert.SuggestedOrder > 0) == true)
        {
            <MudButton Href="/compras/nueva" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddShoppingCart">
                Crear orden de compra
            </MudButton>
        }
    </Actions>
</PageHeader>

<Panel Title="Alertas" Icon="@Icons.Material.Outlined.NotificationImportant"
       Subtitle="Configure mínimos y máximos en Existencias para recibir alertas de cada libro.">
    @if (_warehouses.Count > 1)
    {
        <div class="list-toolbar">
            <MudSelect T="int?" Value="_warehouseId" ValueChanged="WarehouseChangedAsync" Label="Almacén" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="list-toolbar__filter">
                @foreach (CatalogOptionResponse warehouse in _warehouses)
                {
                    <MudSelectItem T="int?" Value="warehouse.Id">@warehouse.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
    }

    @if (_error is not null)
    {
        <ErrorState Title="No fue posible cargar las alertas" Message="@_error" OnRetry="LoadAsync" />
    }
    else if (_alerts is null)
    {
        <LoadingState />
    }
    else if (_alerts.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.CheckCircle" Title="Sin alertas"
                    Message="Todas las existencias están dentro de sus niveles." />
    }
    else
    {
        <div class="table-scroll">
            <MudTable Items="_alerts" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.None" Class="tl-table">
                <HeaderContent>
                    <MudTh>Libro</MudTh>
                    <MudTh>Alerta</MudTh>
                    <MudTh Class="text-right">Disponible</MudTh>
                    <MudTh Class="text-right col-optional">Mín. / máx.</MudTh>
                    <MudTh Class="text-right">Sugerido pedir</MudTh>
                    <MudTh Class="tl-table__actions"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <div class="cell-primary">@context.Title</div>
                        <div class="cell-secondary">@context.BookCode · @context.Warehouse</div>
                    </MudTd>
                    <MudTd><DocumentStatus Code="@context.Level" Text="@context.LevelLabel" /></MudTd>
                    <MudTd Class="number"><strong>@context.Available.ToString("N0")</strong></MudTd>
                    <MudTd Class="number col-optional">@context.Minimum.ToString("N0") / @(context.Maximum == 0 ? "—" : context.Maximum.ToString("N0"))</MudTd>
                    <MudTd Class="number">@(context.SuggestedOrder > 0 ? context.SuggestedOrder.ToString("N0") : "—")</MudTd>
                    <MudTd Class="tl-table__actions">
                        @if (Session.HasPermission(AppPermissions.InventoryViewMovements))
                        {
                            <MudTooltip Text="Ver kardex">
                                <MudIconButton Icon="@Icons.Material.Outlined.ReceiptLong" Size="Size.Small"
                                               Href="@($"/inventario/kardex?libro={context.BookId}")" aria-label="@($"Kardex de {context.Title}")" />
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    }
</Panel>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Inicio", "/"),
        new("Inventario", null, disabled: true),
        new("Alertas", null, disabled: true)
    ];

    private List<StockAlertResponse>? _alerts;
    private IReadOnlyCollection<CatalogOptionResponse> _warehouses = [];
    private int? _warehouseId;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Task load = LoadAsync();
        ApiResult<InventoryCatalogsResponse> catalogs = await InventoryApi.GetCatalogsAsync();
        _warehouses = catalogs.Data?.Warehouses ?? [];
        await load;
    }

    private async Task LoadAsync()
    {
        _error = null;
        _alerts = null;

        ApiResult<List<StockAlertResponse>> result = await InventoryApi.GetAlertsAsync(_warehouseId);

        if (result.Succeeded)
        {
            _alerts = result.Data ?? [];
        }
        else
        {
            _error = result.Message;
        }
    }

    private Task WarehouseChangedAsync(int? value)
    {
        _warehouseId = value;
        return LoadAsync();
    }
}
