@page "/inventario/ajustes/{Id:int}"
@attribute [RequirePermission(AppPermissions.InventoryAdjust)]
@using TikalLibros.Application.DTOs.Inventory
@inject InventoryApi InventoryApi

<PageTitle>@(_adjustment?.Number ?? "Ajuste") | Tikal Libros</PageTitle>

<PageHeader Title="@($"Ajuste {_adjustment?.Number}")" Breadcrumbs="_breadcrumbs" Description="@_adjustment?.Reason" />

@if (_loadError is not null)
{
    <div class="panel"><ErrorState Title="No fue posible cargar el ajuste" Message="@_loadError" OnRetry="LoadAsync" /></div>
}
else if (_adjustment is null)
{
    <div class="panel"><LoadingState Rows="5" /></div>
}
else
{
    <div class="layout-stack">
        <div class="panel">
            <dl class="detail-list">
                <dt>Fecha</dt>
                <dd>@_adjustment.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @_adjustment.Warehouse</dd>
                <dt>Motivo</dt>
                <dd>@_adjustment.Reason (@(_adjustment.Nature > 0 ? "suma existencias" : "resta existencias"))</dd>
                <dt>Registró</dt>
                <dd>@_adjustment.Employee</dd>
                <dt>Movimiento</dt>
                <dd>@(_adjustment.MovementNumber ?? "—")</dd>
                @if (!string.IsNullOrWhiteSpace(_adjustment.Notes))
                {
                    <dt>Observaciones</dt>
                    <dd><p class="notes-block">@_adjustment.Notes</p></dd>
                }
            </dl>
            <div class="form-actions">
                <MudButton Href="/inventario/ajustes" Variant="Variant.Text">Volver</MudButton>
            </div>
        </div>

        <Panel Title="Libros" Icon="@Icons.Material.Outlined.MenuBook">
            <div class="table-scroll">
                <MudTable Items="_adjustment.Lines" Dense="true" Elevation="0" Breakpoint="Breakpoint.None" Class="tl-table">
                    <HeaderContent>
                        <MudTh>Libro</MudTh>
                        <MudTh Class="text-right">Sistema</MudTh>
                        <MudTh Class="text-right">Físico</MudTh>
                        <MudTh Class="text-right">Diferencia</MudTh>
                        @if (_adjustment.Lines.Any(line => line.UnitCost is not null))
                        {
                            <MudTh Class="text-right col-optional">Costo unit.</MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div class="cell-primary">@context.Title</div>
                            <div class="cell-secondary">@context.BookCode</div>
                        </MudTd>
                        <MudTd Class="number">@context.SystemQuantity.ToString("N0")</MudTd>
                        <MudTd Class="number">@context.PhysicalQuantity.ToString("N0")</MudTd>
                        <MudTd Class="@($"number {(context.Difference >= 0 ? "qty-in" : "qty-out")}")">@(context.Difference > 0 ? "+" : "")@context.Difference.ToString("N0")</MudTd>
                        @if (context.UnitCost is not null)
                        {
                            <MudTd Class="number col-optional">@context.UnitCost?.ToString("N2")</MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            </div>
        </Panel>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Inicio", "/"),
        new("Ajustes", "/inventario/ajustes"),
        new("Detalle", null, disabled: true)
    ];

    private AdjustmentResponse? _adjustment;
    private string? _loadError;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        ApiResult<AdjustmentResponse> result = await InventoryApi.GetAdjustmentAsync(Id);
        _adjustment = result.Data;
        _loadError = result.Succeeded ? null : result.Message;
    }
}
