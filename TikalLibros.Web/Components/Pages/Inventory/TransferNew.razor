@page "/inventario/traslados/nuevo"
@attribute [RequirePermission(AppPermissions.InventoryTransfer)]
@using System.ComponentModel.DataAnnotations
@using TikalLibros.Application.Common
@using TikalLibros.Application.DTOs.Common
@using TikalLibros.Application.DTOs.Inventory
@using TikalLibros.Application.Validation
@inject InventoryApi InventoryApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Nuevo traslado | Tikal Libros</PageTitle>

<PageHeader Title="Nuevo traslado" Breadcrumbs="_breadcrumbs"
            Description="Solo se trasladan unidades libres (no reservadas). Salen primero los lotes más antiguos y llegan al destino con el mismo costo." />

@if (_loadError is not null)
{
    <div class="panel"><ErrorState Title="No fue posible cargar los datos" Message="@_loadError" OnRetry="LoadAsync" /></div>
}
else if (_catalogs is null)
{
    <div class="panel"><LoadingState Rows="5" /></div>
}
else
{
    <EditForm Model="_header" OnValidSubmit="SubmitAsync" OnInvalidSubmit="OnInvalidSubmitAsync">
        <DataAnnotationsValidator />
        <div class="layout-stack">
            <div class="panel">
                <FormErrors Result="_saveResult" ShowInvalidHint="_showInvalid" />
                <p class="required-legend">Los campos con <span aria-hidden="true">*</span> son obligatorios.</p>
                <fieldset disabled="@_saving" class="form-fieldset">
                    <div class="form-grid">
                        <MudSelect T="int?" Value="_header.SourceWarehouseId" ValueChanged="SourceChanged" For="@(() => _header.SourceWarehouseId)"
                                   Label="Almacén de origen *" HelperText="Al cambiarlo se vacía la lista de libros."
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (CatalogOptionResponse warehouse in _catalogs.Warehouses)
                            {
                                <MudSelectItem T="int?" Value="warehouse.Id">@warehouse.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="int?" @bind-Value="_header.TargetWarehouseId" For="@(() => _header.TargetWarehouseId)"
                                   Label="Almacén de destino *" Error="@(TargetError is not null)" ErrorText="@TargetError"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (CatalogOptionResponse warehouse in _catalogs.Warehouses.Where(item => item.Id != _header.SourceWarehouseId))
                            {
                                <MudSelectItem T="int?" Value="warehouse.Id">@warehouse.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                    <MudTextField @bind-Value="_header.Notes" For="@(() => _header.Notes)" Label="Observaciones"
                                  HelperText="Por ejemplo, el motivo del traslado o quién lo transporta."
                                  Lines="2" Counter="1000" MaxLength="1000" Class="mt-3 tl-filter-plain"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </fieldset>
            </div>

            <Panel Title="Libros" Icon="@Icons.Material.Outlined.MenuBook">
                <div class="doc-add-line">
                    <MudAutocomplete @ref="_bookSearch" T="StockItemResponse" Label="Agregar libro del almacén de origen" Value="_bookToAdd" ValueChanged="AddBook"
                                     SearchFunc="SearchStockAsync" ToStringFunc="@(item => item?.Title)"
                                     Placeholder="Buscar por título, código o ISBN" DebounceInterval="300" MinCharacters="2"
                                     ResetValueOnEmptyText="true" CoerceText="false" Dense="true" Disabled="@(_saving || _header.SourceWarehouseId is null)"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Class="tl-filter-plain">
                        <ItemTemplate Context="item">
                            <div class="cell-primary">@item.Title</div>
                            <div class="cell-secondary">@item.BookCode · @item.Free.ToString("N0") libres</div>
                        </ItemTemplate>
                        <NoItemsTemplate>
                            <div class="autocomplete-empty">No hay libros con unidades libres en el almacén de origen.</div>
                        </NoItemsTemplate>
                    </MudAutocomplete>
                </div>

                @if (_lines.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.MenuBook" Title="Sin libros"
                                Message="@(_submitted ? "Agregue al menos un libro al traslado." : "Busque y agregue los libros a trasladar.")" />
                }
                else
                {
                    <div class="table-scroll">
                        <MudSimpleTable Dense="true" Elevation="0" Class="tl-table doc-lines">
                            <thead>
                                <tr>
                                    <th>Libro</th>
                                    <th class="text-right">Libres en origen</th>
                                    <th class="doc-lines__qty">Cantidad *</th>
                                    <th class="tl-table__actions"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (LineRow line in _lines)
                                {
                                    <tr @key="line.Stock.BookId">
                                        <td class="doc-lines__title">
                                            <div class="cell-primary">@line.Stock.Title</div>
                                            <div class="cell-secondary">@line.Stock.BookCode</div>
                                            @if (_submitted && line.Error is { } error)
                                            {
                                                <div class="field-error">@error</div>
                                            }
                                        </td>
                                        <td class="number">@line.Stock.Free.ToString("N0")</td>
                                        <td>
                                            <MudNumericField T="int?" @bind-Value="line.Quantity" Min="1" Max="@((int)line.Stock.Free)" Immediate="true"
                                                             Error="@(_submitted && line.Error is not null)"
                                                             Variant="Variant.Outlined" Margin="Margin.Dense" aria-label="@($"Cantidad de {line.Stock.Title}")" />
                                        </td>
                                        <td class="tl-table__actions">
                                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"
                                                           aria-label="@($"Quitar {line.Stock.Title}")" OnClick="() => _lines.Remove(line)" Disabled="_saving" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }

                <div class="form-actions">
                    <MudButton Href="/inventario/traslados" Variant="Variant.Text" Disabled="_saving">Cancelar</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save" Disabled="_saving">
                        @(_saving ? "Registrando…" : "Registrar traslado")
                    </MudButton>
                </div>
            </Panel>
        </div>
    </EditForm>
}

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Inicio", "/"),
        new("Traslados", "/inventario/traslados"),
        new("Nuevo", null, disabled: true)
    ];

    private InventoryCatalogsResponse? _catalogs;
    private readonly HeaderModel _header = new();
    private readonly List<LineRow> _lines = [];
    private MudAutocomplete<StockItemResponse>? _bookSearch;
    private StockItemResponse? _bookToAdd;
    private string? _loadError;
    private bool _saving;
    private bool _submitted;
    private bool _showInvalid;
    private IApiResultView? _saveResult;

    private string? TargetError =>
        _header.TargetWarehouseId is not null && _header.TargetWarehouseId == _header.SourceWarehouseId
            ? "El almacén de destino debe ser distinto del de origen."
            : null;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loadError = null;
        ApiResult<InventoryCatalogsResponse> catalogs = await InventoryApi.GetCatalogsAsync();

        if (!catalogs.Succeeded)
        {
            _loadError = catalogs.Message;
            return;
        }

        _catalogs = catalogs.Data!;
        _header.SourceWarehouseId = _catalogs.Warehouses.FirstOrDefault()?.Id;
        _header.TargetWarehouseId = _catalogs.Warehouses.Skip(1).FirstOrDefault()?.Id;
    }

    private void SourceChanged(int? warehouseId)
    {
        _header.SourceWarehouseId = warehouseId;
        _lines.Clear();

        if (_header.TargetWarehouseId == warehouseId)
        {
            _header.TargetWarehouseId = null;
        }
    }

    private async Task<IEnumerable<StockItemResponse>> SearchStockAsync(string? text, CancellationToken token)
    {
        ApiResult<PagedResponse<StockItemResponse>> stock = await InventoryApi.GetStockAsync(
            new StockQuery { Search = text, WarehouseId = _header.SourceWarehouseId, PageSize = 15 }, token);

        return stock.Data?.Items.Where(item => item.Free > 0 && _lines.All(line => line.Stock.BookId != item.BookId)) ?? [];
    }

    private async Task AddBook(StockItemResponse? item)
    {
        if (item is null || _lines.Any(line => line.Stock.BookId == item.BookId))
        {
            return;
        }

        if (_lines.Count >= SaveTransferRequest.MaxLines)
        {
            Snackbar.Add($"El traslado admite como máximo {SaveTransferRequest.MaxLines} libros.", Severity.Warning);
            return;
        }

        _lines.Add(new LineRow { Stock = item, Quantity = 1 });
        _bookToAdd = null;

        if (_bookSearch is not null)
        {
            await _bookSearch.ClearAsync();
        }
    }

    private async Task SubmitAsync()
    {
        _submitted = true;

        if (_lines.Count == 0 || TargetError is not null || _header.TargetWarehouseId is null || _lines.Any(line => line.Error is not null))
        {
            await OnInvalidSubmitAsync();
            return;
        }

        if (_saving)
        {
            return;
        }

        _saving = true;
        _showInvalid = false;
        _saveResult = null;

        try
        {
            ApiResult<MovementResponse> result = await InventoryApi.CreateTransferAsync(new SaveTransferRequest
            {
                SourceWarehouseId = _header.SourceWarehouseId,
                TargetWarehouseId = _header.TargetWarehouseId,
                Notes = _header.Notes,
                Lines = _lines.Select(line => new TransferLineRequest { BookId = line.Stock.BookId, Quantity = line.Quantity }).ToList()
            });

            if (!result.Succeeded)
            {
                _saveResult = result;
                return;
            }

            Snackbar.Add($"Traslado {result.Data!.Number} registrado; las existencias de ambos almacenes fueron actualizadas.", Severity.Success);
            Navigation.NavigateTo($"/inventario/traslados/{result.Data.Id}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnInvalidSubmitAsync()
    {
        _submitted = true;
        _showInvalid = true;
        _saveResult = null;
        StateHasChanged();
        await JS.InvokeVoidAsync("tikalLibros.scrollToFirstError");
    }

    private sealed class HeaderModel
    {
        [Required(ErrorMessage = "Seleccione el almacén de origen.")]
        public int? SourceWarehouseId { get; set; }

        [Required(ErrorMessage = "Seleccione el almacén de destino.")]
        public int? TargetWarehouseId { get; set; }

        [StringLength(1000, ErrorMessage = "Las observaciones no pueden superar los 1000 caracteres.")]
        [PlainText]
        public string? Notes { get; set; }
    }

    private sealed class LineRow
    {
        public StockItemResponse Stock { get; init; } = default!;

        public int? Quantity { get; set; }

        public string? Error =>
            Quantity is null or < 1 ? "La cantidad debe ser un entero mayor que cero."
            : Quantity > Stock.Free ? $"Solo hay {Stock.Free:N0} unidades libres en el origen."
            : null;
    }
}
