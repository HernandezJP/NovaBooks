@page "/inventario/kardex"
@attribute [RequirePermission(AppPermissions.InventoryViewMovements)]
@using TikalLibros.Application.DTOs.Common
@using TikalLibros.Application.DTOs.Inventory
@inject InventoryApi InventoryApi
@inject BookLookup BookLookup
@inject NavigationManager Navigation

<PageTitle>Kardex | Tikal Libros</PageTitle>

<PageHeader Title="Kardex" Breadcrumbs="_breadcrumbs"
            Description="Entradas, salidas y saldo acumulado de un libro. No incluye movimientos anulados." />

<div class="panel">
    <div class="list-toolbar">
        <MudAutocomplete T="BookOption" Label="Libro" Value="_book" ValueChanged="BookChangedAsync"
                         SearchFunc="BookLookup.SearchAsync" ToStringFunc="@(item => item?.Title)"
                         Placeholder="Buscar por título, código o ISBN" DebounceInterval="300" MinCharacters="2"
                         ResetValueOnEmptyText="true" Dense="true"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Class="list-toolbar__search tl-filter-plain">
            <ItemTemplate Context="book">
                <div class="cell-primary">@book.Title</div>
                <div class="cell-secondary">@book.Code @(book.Isbn is null ? "" : $"· {book.Isbn}")</div>
            </ItemTemplate>
        </MudAutocomplete>

        @if (_warehouses.Count > 1)
        {
            <MudSelect T="int?" Value="_warehouseId" ValueChanged="WarehouseChangedAsync" Label="Almacén" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="list-toolbar__filter">
                @foreach (CatalogOptionResponse warehouse in _warehouses)
                {
                    <MudSelectItem T="int?" Value="warehouse.Id">@warehouse.Name</MudSelectItem>
                }
            </MudSelect>
        }

        <div class="list-toolbar__range">
            <MudDateRangePicker DateRange="_range" DateRangeChanged="RangeChangedAsync" Label="Período" Clearable="true"
                                MaxDate="DateTime.Today" DateFormat="dd/MM/yyyy"
                                Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
    </div>

    @if (BookId is null)
    {
        <EmptyState Icon="@Icons.Material.Outlined.ReceiptLong" Title="Seleccione un libro" Message="Busque el libro para ver su kardex." />
    }
    else if (_error is not null)
    {
        <ErrorState Title="No fue posible cargar el kardex" Message="@_error" OnRetry="LoadAsync" />
    }
    else if (_kardex is null)
    {
        <LoadingState />
    }
    else
    {
        <div class="stat-grid">
            <StatCard Tint="sand" Icon="@Icons.Material.Outlined.Start" Label="Saldo inicial" Value="@_kardex.OpeningBalance.ToString("N0")" />
            <StatCard Tint="mint" Icon="@Icons.Material.Outlined.Add" Label="Entradas" Value="@_kardex.TotalIn.ToString("N0")" />
            <StatCard Tint="peach" Icon="@Icons.Material.Outlined.Remove" Label="Salidas" Value="@_kardex.TotalOut.ToString("N0")" />
            <StatCard Tint="sky" Icon="@Icons.Material.Outlined.Inventory2" Label="Saldo final" Value="@_kardex.ClosingBalance.ToString("N0")" />
        </div>

        @if (_kardex.Truncated)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">Se muestran los últimos 1000 movimientos; reduzca el período para ver el detalle anterior.</MudAlert>
        }

        @if (_kardex.Entries.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.ReceiptLong" Title="Sin movimientos" Message="El libro no tiene movimientos en el período." />
        }
        else
        {
            <div class="table-scroll">
                <MudTable Items="_kardex.Entries" Dense="true" Elevation="0" Breakpoint="Breakpoint.None" Class="tl-table">
                    <HeaderContent>
                        <MudTh>Fecha</MudTh>
                        <MudTh>Movimiento</MudTh>
                        <MudTh Class="col-optional">Documento</MudTh>
                        <MudTh Class="text-right">Entrada</MudTh>
                        <MudTh Class="text-right">Salida</MudTh>
                        <MudTh Class="text-right">Saldo</MudTh>
                        @if (_kardex.Entries.Any(entry => entry.UnitCost is not null))
                        {
                            <MudTh Class="text-right col-optional">Costo unit.</MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Class="cell-nowrap">@context.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                        <MudTd>
                            <div class="cell-primary"><a href="@($"/inventario/movimientos/{context.MovementId}")">@context.MovementNumber</a></div>
                            <div class="cell-secondary">@context.Type · @context.Warehouse @(context.LotNumber is null ? "" : $"· lote {context.LotNumber}")</div>
                        </MudTd>
                        <MudTd Class="col-optional">@(context.DocumentReference ?? "—")</MudTd>
                        <MudTd Class="number qty-in">@(context.In > 0 ? context.In.ToString("N0") : "")</MudTd>
                        <MudTd Class="number qty-out">@(context.Out > 0 ? context.Out.ToString("N0") : "")</MudTd>
                        <MudTd Class="number"><strong>@context.Balance.ToString("N0")</strong></MudTd>
                        @if (context.UnitCost is not null)
                        {
                            <MudTd Class="number col-optional">@context.UnitCost?.ToString("N2")</MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            </div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "libro")]
    public int? BookId { get; set; }

    [SupplyParameterFromQuery(Name = "almacen")]
    public int? WarehouseFromQuery { get; set; }

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Inicio", "/"),
        new("Movimientos", "/inventario/movimientos"),
        new("Kardex", null, disabled: true)
    ];

    private KardexResponse? _kardex;
    private BookOption? _book;
    private IReadOnlyCollection<CatalogOptionResponse> _warehouses = [];
    private int? _warehouseId;
    private DateRange? _range;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _warehouseId = WarehouseFromQuery;
        ApiResult<InventoryCatalogsResponse> catalogs = await InventoryApi.GetCatalogsAsync();
        _warehouses = catalogs.Data?.Warehouses ?? [];
    }

    protected override async Task OnParametersSetAsync()
    {
        if (BookId is not null)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _error = null;
        _kardex = null;

        ApiResult<KardexResponse> result = await InventoryApi.GetKardexAsync(new KardexQuery
        {
            BookId = BookId,
            WarehouseId = _warehouseId,
            From = _range?.Start is { } start ? DateOnly.FromDateTime(start) : null,
            To = _range?.End is { } end ? DateOnly.FromDateTime(end) : null
        });

        if (result.Succeeded)
        {
            _kardex = result.Data;
            _book ??= new BookOption(_kardex!.BookId, _kardex.BookCode, _kardex.Title, null);
        }
        else
        {
            _error = result.Message;
        }
    }

    private Task BookChangedAsync(BookOption? book)
    {
        _book = book;

        if (book is not null)
        {
            Navigation.NavigateTo($"/inventario/kardex?libro={book.Id}{(_warehouseId is null ? "" : $"&almacen={_warehouseId}")}");
        }

        return Task.CompletedTask;
    }

    private Task WarehouseChangedAsync(int? value)
    {
        _warehouseId = value;
        return BookId is null ? Task.CompletedTask : LoadAsync();
    }

    private Task RangeChangedAsync(DateRange? range)
    {
        _range = range;
        return BookId is null ? Task.CompletedTask : LoadAsync();
    }
}
