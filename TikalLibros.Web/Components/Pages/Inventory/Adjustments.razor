@page "/inventario/ajustes"
@attribute [RequirePermission(AppPermissions.InventoryAdjust)]
@implements IDisposable
@using TikalLibros.Application.Common
@using TikalLibros.Application.DTOs.Inventory
@inject InventoryApi InventoryApi
@inject NavigationManager Navigation

<PageTitle>Ajustes de inventario | Tikal Libros</PageTitle>

<PageHeader Title="Ajustes de inventario"
            Description="Correcciones por conteo físico, faltantes, sobrantes o producto dañado."
            Breadcrumbs="_breadcrumbs">
    <Actions>
        <MudButton Href="/inventario/ajustes/nuevo" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PlaylistAddCheck">
            Nuevo ajuste
        </MudButton>
    </Actions>
</PageHeader>

<Panel Title="Ajustes" Subtitle="Busque por número de ajuste o por el empleado que lo registró." Icon="@Icons.Material.Outlined.Tune">
    <div class="list-toolbar">
        <MudTextField @bind-Value="_search" Placeholder="Número o empleado"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                      DebounceInterval="400" OnDebounceIntervalElapsed="ReloadAsync"
                      OnClearButtonClick="ClearSearchAsync" MaxLength="100"
                      aria-label="Buscar ajustes" Class="list-toolbar__search tl-filter-plain" />
    </div>

    @if (_error is not null)
    {
        <ErrorState Title="No fue posible cargar los ajustes" Message="@_error" OnRetry="LoadAsync" />
    }
    else if (_page is null)
    {
        <LoadingState />
    }
    else if (_page.Items.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Tune" Title="Sin ajustes"
                    Message="@(string.IsNullOrWhiteSpace(_search) ? "Registre un ajuste cuando el conteo físico no coincida con el sistema." : "No hay ajustes que coincidan con la búsqueda.")" />
    }
    else
    {
        <div class="table-scroll">
            <MudTable Items="_page.Items" Hover="true" Dense="true" Elevation="0" Breakpoint="Breakpoint.None" Class="tl-table tl-table--clickable"
                      OnRowClick="@((TableRowClickEventArgs<AdjustmentListItemResponse> args) => Navigation.NavigateTo($"/inventario/ajustes/{args.Item!.Id}"))">
                <HeaderContent>
                    <MudTh>Ajuste</MudTh>
                    <MudTh>Motivo</MudTh>
                    <MudTh Class="col-optional">Almacén</MudTh>
                    <MudTh Class="text-right">Unidades</MudTh>
                    <MudTh Class="col-optional">Registró</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <div class="cell-primary">@context.Number</div>
                        <div class="cell-secondary">@context.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                    </MudTd>
                    <MudTd>@context.Reason</MudTd>
                    <MudTd Class="col-optional">@context.Warehouse</MudTd>
                    <MudTd Class="@($"number {(context.Units >= 0 ? "qty-in" : "qty-out")}")">@(context.Units > 0 ? "+" : "")@context.Units.ToString("N0")</MudTd>
                    <MudTd Class="col-optional">
                        <div>@context.Employee</div>
                        <div class="cell-secondary">@context.EmployeeCode</div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>
        <ListPager Page="_page.Page" PageSize="_page.PageSize" TotalItems="_page.TotalItems"
                   TotalPages="_page.TotalPages" PageChanged="PageChangedAsync" />
    }
</Panel>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Inicio", "/"),
        new("Inventario", null, disabled: true),
        new("Ajustes", null, disabled: true)
    ];

    private PagedResponse<AdjustmentListItemResponse>? _page;
    private string? _search;
    private int _pageNumber = 1;
    private string? _error;
    private CancellationTokenSource? _loadCancellation;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loadCancellation?.Cancel();
        _loadCancellation = new CancellationTokenSource();
        CancellationToken token = _loadCancellation.Token;

        _error = null;
        ApiResult<PagedResponse<AdjustmentListItemResponse>> result = await InventoryApi.GetAdjustmentsAsync(_search, _pageNumber, 15, token);

        if (token.IsCancellationRequested)
        {
            return;
        }

        _page = result.Data;
        _error = result.Succeeded ? null : result.Message;
    }

    private Task ReloadAsync(string? _)
    {
        _pageNumber = 1;
        return LoadAsync();
    }

    private Task ClearSearchAsync(MouseEventArgs _)
    {
        _search = null;
        _pageNumber = 1;
        return LoadAsync();
    }

    private Task PageChangedAsync(int page)
    {
        _pageNumber = page;
        return LoadAsync();
    }

    public void Dispose()
    {
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
    }
}
