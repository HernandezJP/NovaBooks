@using TikalLibros.Application.DTOs.PriceLists
@inject PriceListsApi PriceListsApi

<MudDialog>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="SaveAsync" OnInvalidSubmit="OnInvalidSubmit" id="price-list-form">
            <DataAnnotationsValidator />
            <ServerValidator Result="_saveResult" />
            <FormErrors Result="_saveResult" ShowInvalidHint="_showInvalid" />
            <p class="required-legend">Los campos con <span aria-hidden="true">*</span> son obligatorios.</p>

            <div class="form-grid">
                <MudTextField @bind-Value="_model.Name" For="@(() => _model.Name)" Label="Nombre *"
                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="150" Class="tl-filter-business" />
                <MudTextField T="string" Value="@(PriceList?.Code ?? "Se asignará al guardar")" Label="Código"
                              HelperText="Lo asigna el sistema a partir del nombre."
                              ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </div>
            <MudTextField @bind-Value="_model.Description" For="@(() => _model.Description)" Label="Descripción"
                          Lines="2" MaxLength="500" Counter="500" Variant="Variant.Outlined" Margin="Margin.Dense" Class="tl-filter-plain mt-2" />
            <MudSwitch T="bool" @bind-Value="_model.IsDefault" Color="Color.Primary" Disabled="@(PriceList?.IsDefault == true)"
                       Label="Lista predeterminada" Class="mt-2" />
            <p class="form-hint">
                @(PriceList?.IsDefault == true
                    ? "Es la lista predeterminada. Para cambiarla, marque otra lista como predeterminada."
                    : "Si la marca, pasa a proponerse en ventas y pedidos y la anterior deja de serlo.")
            </p>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => Dialog.Cancel()" Disabled="_saving">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" form="price-list-form" Disabled="_saving">
            @if (_saving)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            }
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>Lista a editar; null para crear.</summary>
    [Parameter]
    public PriceListResponse? PriceList { get; set; }

    private SavePriceListRequest _model = new();
    private bool _saving;
    private bool _showInvalid;
    private IApiResultView? _saveResult;

    protected override void OnInitialized()
    {
        if (PriceList is not null)
        {
            _model = new SavePriceListRequest { Name = PriceList.Name, Description = PriceList.Description, IsDefault = PriceList.IsDefault };
        }
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _showInvalid = false;
        _saveResult = null;

        try
        {
            ApiResult<PriceListResponse> result = PriceList is null
                ? await PriceListsApi.CreateAsync(_model)
                : await PriceListsApi.UpdateAsync(PriceList.Id, _model);

            if (result.Succeeded)
            {
                Dialog.Close(DialogResult.Ok(result.Data));
                return;
            }

            _saveResult = result;
        }
        finally
        {
            _saving = false;
        }
    }

    private void OnInvalidSubmit()
    {
        _showInvalid = true;
        _saveResult = null;
    }
}
