@page "/configuracion/cajas"
@attribute [RequirePermission(AppPermissions.ConfigurationOrganization)]
@implements IDisposable
@using TikalLibros.Application.DTOs.Organization
@inject CashRegistersApi CashRegistersApi
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Cajas | Tikal Libros</PageTitle>

<PageHeader Title="Cajas" Description="Cajas registradoras de cada sucursal. Una caja abierta no puede desactivarse." />

<Panel Title="Cajas" Subtitle="Busque por nombre, código o sucursal." Icon="@Icons.Material.Outlined.PointOfSale">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
            Nueva caja
        </MudButton>
    </Actions>
    <ChildContent>
        <div class="list-toolbar">
            <MudTextField @bind-Value="_search" Placeholder="Buscar cajas"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                          DebounceInterval="400" OnDebounceIntervalElapsed="_ => LoadAsync()"
                          OnClearButtonClick="ClearSearchAsync" MaxLength="100"
                          aria-label="Buscar cajas" Class="tl-filter-plain list-toolbar__search" />
            <MudSelect T="StatusFilter" Value="_status" ValueChanged="StatusChangedAsync" Label="Estado"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="list-toolbar__filter">
                <MudSelectItem Value="StatusFilter.Active">Activas</MudSelectItem>
                <MudSelectItem Value="StatusFilter.Inactive">Inactivas</MudSelectItem>
                <MudSelectItem Value="StatusFilter.All">Todas</MudSelectItem>
            </MudSelect>
        </div>

        @if (_loading && _items is null)
        {
            <LoadingState />
        }
        else if (_error is not null)
        {
            <ErrorState Title="No fue posible cargar las cajas" Message="@_error" OnRetry="LoadAsync" />
        }
        else if (_items is { Count: 0 })
        {
            <EmptyState Icon="@Icons.Material.Outlined.PointOfSale" Title="No se encontraron cajas" Message="Pruebe con otro término de búsqueda o estado." />
        }
        else if (_items is not null)
        {
            <div class="table-scroll">
                <MudTable Items="_items" Hover="true" Dense="true" Elevation="0" Loading="_loading" Breakpoint="Breakpoint.None" Class="tl-table">
                    <HeaderContent>
                        <MudTh>Caja</MudTh>
                        <MudTh>Sucursal</MudTh>
                        <MudTh Class="col-optional">Descripción</MudTh>
                        <MudTh>Situación</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh Class="tl-table__actions">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div class="cell-primary">@context.Name</div>
                            <div class="cell-secondary">@context.Code</div>
                        </MudTd>
                        <MudTd>@context.Branch</MudTd>
                        <MudTd Class="col-optional">@(context.Description ?? "—")</MudTd>
                        <MudTd>
                            @if (context.IsOpen)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Abierta</MudChip>
                                <div class="cell-secondary">@context.OpenedBy</div>
                            }
                            else
                            {
                                <span class="cell-secondary">Cerrada</span>
                            }
                        </MudTd>
                        <MudTd><StatusChip IsActive="context.IsActive" ActiveText="Activa" InactiveText="Inactiva" /></MudTd>
                        <MudTd Class="tl-table__actions">
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                                     aria-label="@($"Acciones para {context.Name}")">
                                <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="() => EditAsync(context)">Editar</MudMenuItem>
                                <MudMenuItem Icon="@(context.IsActive ? Icons.Material.Outlined.Block : Icons.Material.Outlined.CheckCircle)"
                                             Disabled="@(context.IsActive && context.IsOpen)"
                                             OnClick="() => ToggleStatusAsync(context)">
                                    @(context.IsActive ? "Desactivar" : "Reactivar")
                                </MudMenuItem>
                            </MudMenu>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        }
    </ChildContent>
</Panel>

@code {
    private List<CashRegisterAdminResponse>? _items;
    private string? _search;
    private StatusFilter _status = StatusFilter.Active;
    private bool _loading;
    private string? _error;
    private CancellationTokenSource? _loadCancellation;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loadCancellation?.Cancel();
        _loadCancellation = new CancellationTokenSource();
        CancellationToken token = _loadCancellation.Token;

        _loading = true;
        _error = null;

        ApiResult<List<CashRegisterAdminResponse>> result = await CashRegistersApi.GetAllAsync(_search, _status, token);

        if (token.IsCancellationRequested)
        {
            return;
        }

        _items = result.Data;
        _error = result.Succeeded ? null : result.Message;
        _loading = false;
    }

    private Task ClearSearchAsync(MouseEventArgs _)
    {
        _search = null;
        return LoadAsync();
    }

    private Task StatusChangedAsync(StatusFilter status)
    {
        _status = status;
        return LoadAsync();
    }

    private async Task CreateAsync()
    {
        CashRegisterAdminResponse? register = await Dialogs.ShowFormAsync<CashRegisterFormDialog, CashRegisterAdminResponse>(
            "Nueva caja", new DialogParameters<CashRegisterFormDialog>(), DialogExtensions.WideFormOptions);

        if (register is not null)
        {
            Snackbar.Add($"Caja {register.Name} registrada.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task EditAsync(CashRegisterAdminResponse register)
    {
        CashRegisterAdminResponse? updated = await Dialogs.ShowFormAsync<CashRegisterFormDialog, CashRegisterAdminResponse>(
            "Editar caja",
            new DialogParameters<CashRegisterFormDialog> { { dialog => dialog.CashRegister, register } },
            DialogExtensions.WideFormOptions);

        if (updated is not null)
        {
            Snackbar.Add($"Caja {updated.Name} actualizada.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ToggleStatusAsync(CashRegisterAdminResponse register)
    {
        bool activate = !register.IsActive;

        bool confirmed = await Dialogs.ConfirmAsync(
            activate ? "Reactivar caja" : "Desactivar caja",
            activate
                ? $"¿Desea reactivar la caja {register.Name}?"
                : $"¿Desea desactivar la caja {register.Name}? Su historial de aperturas y cierres se conserva.",
            activate ? "Reactivar" : "Desactivar",
            activate ? Color.Primary : Color.Error);

        if (!confirmed)
        {
            return;
        }

        ApiResult<CashRegisterAdminResponse> result = await CashRegistersApi.ChangeStatusAsync(register.Id, activate);

        if (result.Succeeded)
        {
            Snackbar.Add($"Caja {register.Name} {(activate ? "reactivada" : "desactivada")}.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Message, Severity.Error);
        }
    }

    public void Dispose()
    {
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
    }
}
