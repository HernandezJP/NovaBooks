@page "/configuracion/almacenes"
@attribute [RequirePermission(AppPermissions.ConfigurationOrganization)]
@implements IDisposable
@using TikalLibros.Application.DTOs.Organization
@inject WarehousesApi WarehousesApi
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Almacenes | Tikal Libros</PageTitle>

<PageHeader Title="Almacenes" Description="Bodegas de cada sucursal. El almacén principal se propone primero en ventas y recepciones." />

<Panel Title="Almacenes" Subtitle="Busque por nombre, código o sucursal." Icon="@Icons.Material.Outlined.Warehouse">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
            Nuevo almacén
        </MudButton>
    </Actions>
    <ChildContent>
        <div class="list-toolbar">
            <MudTextField @bind-Value="_search" Placeholder="Buscar almacenes"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                          DebounceInterval="400" OnDebounceIntervalElapsed="_ => LoadAsync()"
                          OnClearButtonClick="ClearSearchAsync" MaxLength="100"
                          aria-label="Buscar almacenes" Class="tl-filter-plain list-toolbar__search" />
            <MudSelect T="StatusFilter" Value="_status" ValueChanged="StatusChangedAsync" Label="Estado"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="list-toolbar__filter">
                <MudSelectItem Value="StatusFilter.Active">Activos</MudSelectItem>
                <MudSelectItem Value="StatusFilter.Inactive">Inactivos</MudSelectItem>
                <MudSelectItem Value="StatusFilter.All">Todos</MudSelectItem>
            </MudSelect>
        </div>

        @if (_loading && _items is null)
        {
            <LoadingState />
        }
        else if (_error is not null)
        {
            <ErrorState Title="No fue posible cargar los almacenes" Message="@_error" OnRetry="LoadAsync" />
        }
        else if (_items is { Count: 0 })
        {
            <EmptyState Icon="@Icons.Material.Outlined.Warehouse" Title="No se encontraron almacenes" Message="Pruebe con otro término de búsqueda o estado." />
        }
        else if (_items is not null)
        {
            <div class="table-scroll">
                <MudTable Items="_items" Hover="true" Dense="true" Elevation="0" Loading="_loading" Breakpoint="Breakpoint.None" Class="tl-table">
                    <HeaderContent>
                        <MudTh>Almacén</MudTh>
                        <MudTh>Sucursal</MudTh>
                        <MudTh Class="col-optional">Descripción</MudTh>
                        <MudTh Class="text-right">Títulos con existencia</MudTh>
                        <MudTh Class="text-right">Unidades</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh Class="tl-table__actions">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div class="cell-primary">
                                @context.Name
                                @if (context.IsMain)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="ml-1">Principal</MudChip>
                                }
                            </div>
                            <div class="cell-secondary">@context.Code</div>
                        </MudTd>
                        <MudTd>@context.Branch</MudTd>
                        <MudTd Class="col-optional">@(context.Description ?? "—")</MudTd>
                        <MudTd Class="text-right">@context.BooksWithStock.ToString("N0")</MudTd>
                        <MudTd Class="text-right">@context.Units.ToString("N0")</MudTd>
                        <MudTd><StatusChip IsActive="context.IsActive" ActiveText="Activo" InactiveText="Inactivo" /></MudTd>
                        <MudTd Class="tl-table__actions">
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                                     aria-label="@($"Acciones para {context.Name}")">
                                <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="() => EditAsync(context)">Editar</MudMenuItem>
                                @if (!context.IsMain)
                                {
                                    <MudMenuItem Icon="@(context.IsActive ? Icons.Material.Outlined.Block : Icons.Material.Outlined.CheckCircle)"
                                                 OnClick="() => ToggleStatusAsync(context)">
                                        @(context.IsActive ? "Desactivar" : "Reactivar")
                                    </MudMenuItem>
                                }
                            </MudMenu>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        }
    </ChildContent>
</Panel>

@code {
    private List<WarehouseResponse>? _items;
    private string? _search;
    private StatusFilter _status = StatusFilter.Active;
    private bool _loading;
    private string? _error;
    private CancellationTokenSource? _loadCancellation;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loadCancellation?.Cancel();
        _loadCancellation = new CancellationTokenSource();
        CancellationToken token = _loadCancellation.Token;

        _loading = true;
        _error = null;

        ApiResult<List<WarehouseResponse>> result = await WarehousesApi.GetAllAsync(_search, _status, token);

        if (token.IsCancellationRequested)
        {
            return;
        }

        _items = result.Data;
        _error = result.Succeeded ? null : result.Message;
        _loading = false;
    }

    private Task ClearSearchAsync(MouseEventArgs _)
    {
        _search = null;
        return LoadAsync();
    }

    private Task StatusChangedAsync(StatusFilter status)
    {
        _status = status;
        return LoadAsync();
    }

    private async Task CreateAsync()
    {
        WarehouseResponse? warehouse = await Dialogs.ShowFormAsync<WarehouseFormDialog, WarehouseResponse>(
            "Nuevo almacén", new DialogParameters<WarehouseFormDialog>(), DialogExtensions.WideFormOptions);

        if (warehouse is not null)
        {
            Snackbar.Add($"Almacén {warehouse.Name} registrado.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task EditAsync(WarehouseResponse warehouse)
    {
        WarehouseResponse? updated = await Dialogs.ShowFormAsync<WarehouseFormDialog, WarehouseResponse>(
            "Editar almacén",
            new DialogParameters<WarehouseFormDialog> { { dialog => dialog.Warehouse, warehouse } },
            DialogExtensions.WideFormOptions);

        if (updated is not null)
        {
            Snackbar.Add($"Almacén {updated.Name} actualizado.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ToggleStatusAsync(WarehouseResponse warehouse)
    {
        bool activate = !warehouse.IsActive;

        bool confirmed = await Dialogs.ConfirmAsync(
            activate ? "Reactivar almacén" : "Desactivar almacén",
            activate
                ? $"¿Desea reactivar el almacén {warehouse.Name}?"
                : $"¿Desea desactivar el almacén {warehouse.Name}? Solo es posible si no tiene existencias ni reservas.",
            activate ? "Reactivar" : "Desactivar",
            activate ? Color.Primary : Color.Error);

        if (!confirmed)
        {
            return;
        }

        ApiResult<WarehouseResponse> result = await WarehousesApi.ChangeStatusAsync(warehouse.Id, activate);

        if (result.Succeeded)
        {
            Snackbar.Add($"Almacén {warehouse.Name} {(activate ? "reactivado" : "desactivado")}.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Message, Severity.Error);
        }
    }

    public void Dispose()
    {
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
    }
}
