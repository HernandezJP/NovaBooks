@page "/empleados/nuevo"
@page "/empleados/{Id:int}"
@attribute [RequirePermission(AppPermissions.EmployeesView)]
@using TikalLibros.Application.DTOs.Employees
@using TikalLibros.Application.DTOs.Users
@inject EmployeesApi EmployeesApi
@inject SessionState Session
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>@PageTitleText | Tikal Libros</PageTitle>

@if (IsCreate && !Session.HasPermission(AppPermissions.EmployeesCreate))
{
    <AccessDenied Permission="@AppPermissions.EmployeesCreate" />
}
else
{
    <PageHeader Title="@PageTitleText" Breadcrumbs="_breadcrumbs"
                Description="@(IsCreate ? "Registre los datos personales, el puesto y la sucursal del empleado." : $"{_employee?.Code} · {_employee?.Position}")">
        <Actions>
            @if (!IsCreate && _employee is not null)
            {
                <StatusChip IsActive="_employee.IsActive" />
            }
        </Actions>
    </PageHeader>

    @if (_loadError is not null)
    {
        <div class="panel">
            <ErrorState Title="No fue posible cargar el empleado" Message="@_loadError" OnRetry="LoadAsync" />
        </div>
    }
    else if (_catalogs is null || (!IsCreate && _employee is null))
    {
        <div class="panel"><LoadingState Rows="6" /></div>
    }
    else
    {
        <div class="layout-stack">
            <EditForm Model="_model" OnValidSubmit="SaveAsync" OnInvalidSubmit="OnInvalidSubmitAsync">
                <DataAnnotationsValidator />
                <ServerValidator Result="_saveResult" />

                <div class="panel">
                    <FormErrors Result="_saveResult" ShowInvalidHint="_showInvalid" />
                    <p class="required-legend">Los campos con <span aria-hidden="true">*</span> son obligatorios.</p>

                    <fieldset disabled="@(ReadOnly || _saving)" class="form-fieldset">
                        <div class="form-section">
                            <div class="form-section__title">Datos personales</div>
                            <div class="form-grid">
                                <MudTextField @bind-Value="_model.FirstName" For="@(() => _model.FirstName)" Label="Primer nombre *"
                                              MaxLength="100" Class="tl-filter-name" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="ReadOnly" />
                                <MudTextField @bind-Value="_model.MiddleName" For="@(() => _model.MiddleName)" Label="Segundo nombre"
                                              MaxLength="100" Class="tl-filter-name" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="ReadOnly" />
                                <MudTextField @bind-Value="_model.LastName" For="@(() => _model.LastName)" Label="Primer apellido *"
                                              MaxLength="100" Class="tl-filter-name" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="ReadOnly" />
                                <MudTextField @bind-Value="_model.SecondLastName" For="@(() => _model.SecondLastName)" Label="Segundo apellido"
                                              MaxLength="100" Class="tl-filter-name" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="ReadOnly" />
                                <MudTextField @bind-Value="_model.Dpi" For="@(() => _model.Dpi)" Label="DPI *"
                                              MaxLength="15" Class="tl-filter-dpi" InputMode="InputMode.numeric"
                                              HelperText="13 dígitos; puede separarlos con espacios (2345 67890 0101)."
                                              Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="ReadOnly" />
                                <DateField @bind-Value="BirthDate" Label="Fecha de nacimiento" MaxDate="DateTime.Today.AddYears(-SaveEmployeeRequest.MinimumAge)" HelperText="Debe ser mayor de edad." ReadOnly="ReadOnly" />
                            </div>
                        </div>

                        <div class="form-section">
                            <div class="form-section__title">Puesto</div>
                            <div class="form-grid">
                                <MudSelect T="int?" @bind-Value="_model.PositionId" For="@(() => _model.PositionId)" Label="Puesto *"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="ReadOnly">
                                    @foreach (var item in _catalogs.Positions)
                                    {
                                        <MudSelectItem T="int?" Value="item.Id">@item.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudSelect T="int?" @bind-Value="_model.BranchId" For="@(() => _model.BranchId)" Label="Sucursal *"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="ReadOnly">
                                    @foreach (var item in _catalogs.Branches)
                                    {
                                        <MudSelectItem T="int?" Value="item.Id">@item.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                <DateField @bind-Value="HireDate" Label="Fecha de contratación *" MaxDate="DateTime.Today.AddDays(30)" ReadOnly="ReadOnly" />
                                <DateField @bind-Value="EndDate" Label="Fecha de finalización" MinDate="HireDate" Clearable="true" ReadOnly="ReadOnly" />
                            </div>
                            <ValidationMessage For="@(() => _model.HireDate)" class="field-error" />
                            <ValidationMessage For="@(() => _model.EndDate)" class="field-error" />
                            <ValidationMessage For="@(() => _model.BirthDate)" class="field-error" />
                        </div>

                        <div class="form-section">
                            <div class="form-section__title">Contacto</div>
                            <div class="form-grid">
                                <MudTextField @bind-Value="_model.Email" For="@(() => _model.Email)" Label="Correo electrónico"
                                              InputType="InputType.Email" MaxLength="256"
                                              HelperText="Se propone como correo del usuario."
                                              Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="ReadOnly" Class="tl-filter-email" />
                                <div></div>
                                <MudSelect T="int?" @bind-Value="_model.PhoneTypeId" For="@(() => _model.PhoneTypeId)" Label="Tipo de teléfono"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" ReadOnly="ReadOnly">
                                    @foreach (var item in _catalogs.PhoneTypes)
                                    {
                                        <MudSelectItem T="int?" Value="item.Id">@item.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudTextField @bind-Value="_model.Phone" For="@(() => _model.Phone)" Label="Teléfono"
                                              InputType="InputType.Telephone" MaxLength="25" Class="tl-filter-phone"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="ReadOnly" />
                            </div>
                        </div>
                    </fieldset>

                    <div class="form-actions">
                        <MudButton Href="/empleados" Variant="Variant.Text" Disabled="_saving">@(ReadOnly ? "Volver" : "Cancelar")</MudButton>
                        @if (!ReadOnly)
                        {
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save" Disabled="_saving">
                                @(_saving ? "Guardando…" : "Guardar")
                            </MudButton>
                        }
                    </div>
                </div>
            </EditForm>

            @if (!IsCreate && _employee is not null)
            {
                <Panel Title="Usuario del sistema" Icon="@Icons.Material.Outlined.ManageAccounts"
                       Subtitle="Con un usuario el empleado puede iniciar sesión; las compras e inventario quedan a su nombre.">
                    @if (_employee.UserId is null)
                    {
                        <EmptyState Icon="@Icons.Material.Outlined.PersonOff" Title="Sin usuario"
                                    Message="@(_employee.IsActive ? "Cree un usuario para que este empleado pueda trabajar en el sistema." : "Reactive al empleado para crearle un usuario.")" />
                        @if (_employee.IsActive && Session.HasPermission(AppPermissions.UsersCreate))
                        {
                            <div class="form-actions">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PersonAdd"
                                           OnClick="CreateUserAsync">
                                    Crear usuario
                                </MudButton>
                            </div>
                        }
                    }
                    else
                    {
                        <dl class="detail-list">
                            <dt>Usuario</dt>
                            <dd><span class="role-pill">@_employee.UserName</span></dd>
                            <dt>Estado</dt>
                            <dd><StatusChip IsActive="_employee.UserIsActive == true" /></dd>
                        </dl>
                        @if (Session.HasPermission(AppPermissions.UsersUpdate))
                        {
                            <div class="form-actions">
                                <MudButton Href="/usuarios" Variant="Variant.Text">Administrar usuarios</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.LinkOff"
                                           OnClick="UnlinkUserAsync">
                                    Desvincular usuario
                                </MudButton>
                            </div>
                        }
                    }
                </Panel>
            }
        </div>
    }
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private SaveEmployeeRequest _model = new();
    private EmployeeResponse? _employee;
    private EmployeeCatalogsResponse? _catalogs;
    private string? _loadError;
    private bool _saving;
    private bool _showInvalid;
    private IApiResultView? _saveResult;
    private List<BreadcrumbItem> _breadcrumbs = [];

    private bool IsCreate => Id is null;

    private bool ReadOnly => !IsCreate && !Session.HasPermission(AppPermissions.EmployeesUpdate);

    private string PageTitleText => IsCreate ? "Nuevo empleado" : _employee?.FullName ?? "Empleado";

    private DateTime? BirthDate
    {
        get => _model.BirthDate?.ToDateTime(TimeOnly.MinValue);
        set => _model.BirthDate = value is null ? null : DateOnly.FromDateTime(value.Value);
    }

    private DateTime? HireDate
    {
        get => _model.HireDate?.ToDateTime(TimeOnly.MinValue);
        set => _model.HireDate = value is null ? null : DateOnly.FromDateTime(value.Value);
    }

    private DateTime? EndDate
    {
        get => _model.EndDate?.ToDateTime(TimeOnly.MinValue);
        set => _model.EndDate = value is null ? null : DateOnly.FromDateTime(value.Value);
    }

    protected override async Task OnParametersSetAsync()
    {
        _breadcrumbs =
        [
            new("Inicio", "/"),
            new("Empleados", "/empleados"),
            new(IsCreate ? "Nuevo" : "Detalle", null, disabled: true)
        ];

        if (IsCreate && !Session.HasPermission(AppPermissions.EmployeesCreate))
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadError = null;

        Task<ApiResult<EmployeeCatalogsResponse>> catalogsTask = EmployeesApi.GetCatalogsAsync();
        Task<ApiResult<EmployeeResponse>>? employeeTask = IsCreate ? null : EmployeesApi.GetAsync(Id!.Value);

        ApiResult<EmployeeCatalogsResponse> catalogs = await catalogsTask;

        if (!catalogs.Succeeded)
        {
            _loadError = catalogs.Message;
            return;
        }

        _catalogs = catalogs.Data;

        if (employeeTask is null)
        {
            _model = new SaveEmployeeRequest
            {
                BranchId = _catalogs!.Branches.FirstOrDefault()?.Id,
                HireDate = DateOnly.FromDateTime(DateTime.Today)
            };
            return;
        }

        ApiResult<EmployeeResponse> employee = await employeeTask;

        if (!employee.Succeeded || employee.Data is null)
        {
            _loadError = employee.Message;
            return;
        }

        SetEmployee(employee.Data);
    }

    private void SetEmployee(EmployeeResponse employee)
    {
        _employee = employee;
        _model = new SaveEmployeeRequest
        {
            FirstName = employee.FirstName,
            MiddleName = employee.MiddleName,
            LastName = employee.LastName,
            SecondLastName = employee.SecondLastName,
            BirthDate = employee.BirthDate,
            Dpi = employee.Dpi ?? string.Empty,
            Email = employee.Email,
            PhoneTypeId = employee.PhoneTypeId,
            Phone = employee.Phone,
            PositionId = employee.PositionId,
            BranchId = employee.BranchId,
            HireDate = employee.HireDate,
            EndDate = employee.EndDate
        };
    }

    private async Task SaveAsync()
    {
        if (_saving || ReadOnly)
        {
            return;
        }

        _saving = true;
        _showInvalid = false;
        _saveResult = null;

        try
        {
            ApiResult<EmployeeResponse> result = IsCreate
                ? await EmployeesApi.CreateAsync(_model)
                : await EmployeesApi.UpdateAsync(Id!.Value, _model);

            if (!result.Succeeded || result.Data is null)
            {
                _saveResult = result;
                return;
            }

            if (IsCreate)
            {
                Snackbar.Add($"Empleado {result.Data.Code} creado. Ahora puede crearle un usuario.", Severity.Success);
                Navigation.NavigateTo($"/empleados/{result.Data.Id}");
            }
            else
            {
                Snackbar.Add($"Empleado {result.Data.Code} actualizado.", Severity.Success);
                Navigation.NavigateTo("/empleados");
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CreateUserAsync()
    {
        DialogParameters<EmployeeUserDialog> parameters = new()
        {
            { dialog => dialog.Employee, _employee },
            { dialog => dialog.CanAssignRoles, Session.HasPermission(AppPermissions.UsersAssignRoles) }
        };

        IDialogReference reference = await Dialogs.ShowAsync<EmployeeUserDialog>(
            $"Crear usuario para {_employee!.FullName}", parameters, DialogExtensions.FormOptions);

        if (await reference.Result is { Canceled: false, Data: UserResponse user })
        {
            Snackbar.Add($"Usuario {user.UserName} creado y vinculado.", Severity.Success);
            await ReloadEmployeeAsync();
        }
    }

    private async Task UnlinkUserAsync()
    {
        bool confirmed = await Dialogs.ConfirmAsync(
            "Desvincular usuario",
            $"El usuario {_employee!.UserName} seguirá existiendo, pero ya no podrá registrar compras ni inventario hasta vincularlo con un empleado.",
            "Desvincular",
            Color.Error);

        if (!confirmed)
        {
            return;
        }

        ApiResult<UserResponse> result = await EmployeesApi.AssignUserAsync(_employee.UserId!.Value, null);

        if (result.Succeeded)
        {
            Snackbar.Add($"Usuario {_employee.UserName} desvinculado.", Severity.Success);
            await ReloadEmployeeAsync();
        }
        else
        {
            Snackbar.Add(result.Message, Severity.Error);
        }
    }

    private async Task ReloadEmployeeAsync()
    {
        ApiResult<EmployeeResponse> employee = await EmployeesApi.GetAsync(Id!.Value);

        if (employee.Succeeded && employee.Data is not null)
        {
            SetEmployee(employee.Data);
        }
    }

    private async Task OnInvalidSubmitAsync()
    {
        _showInvalid = true;
        _saveResult = null;
        StateHasChanged();
        await JS.InvokeVoidAsync("tikalLibros.scrollToFirstError");
    }
}
