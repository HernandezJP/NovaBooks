@page "/caja/aperturas/{Id:int}"
@attribute [RequirePermission(AppPermissions.CashView)]
@using TikalLibros.Application.DTOs.Cash
@inject CashApi CashApi

<PageTitle>Apertura de caja | Tikal Libros</PageTitle>

<PageHeader Title="@(_session is null ? "Apertura de caja" : $"{_session.CashRegister} · {_session.OpenedAt.ToLocalTime():dd/MM/yyyy}")"
            Description="@_session?.Employee" Breadcrumbs="_breadcrumbs" />

@if (_error is not null)
{
    <div class="panel"><ErrorState Title="No fue posible cargar la apertura" Message="@_error" OnRetry="LoadAsync" /></div>
}
else if (_session is null)
{
    <div class="panel"><LoadingState Rows="5" /></div>
}
else
{
    <div class="layout-stack">
        <CashSessionView Session="_session" SessionChanged="session => _session = session" MovementTypes="_types" />
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Inicio", "/"),
        new("Aperturas y cierres", "/caja/aperturas"),
        new("Detalle", null, disabled: true)
    ];

    private CashSessionResponse? _session;
    private IReadOnlyCollection<CashMovementTypeResponse> _types = [];
    private string? _error;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        Task<ApiResult<CashCatalogsResponse>> catalogs = CashApi.GetCatalogsAsync();
        ApiResult<CashSessionResponse> result = await CashApi.GetSessionAsync(Id);
        _types = (await catalogs).Data?.MovementTypes ?? [];
        _session = result.Data;
        _error = result.Succeeded ? null : result.Message;
    }
}
