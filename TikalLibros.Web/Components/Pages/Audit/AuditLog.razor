@page "/auditoria"
@attribute [RequirePermission(AppPermissions.ReportsAudit)]
@implements IDisposable
@using TikalLibros.Application.Common
@using TikalLibros.Application.DTOs.Audit
@inject AuditApi AuditApi
@inject IDialogService Dialogs

<PageTitle>Auditoría | Tikal Libros</PageTitle>

<PageHeader Title="Auditoría"
            Description="Quién hizo qué y cuándo: toda operación que modifica datos, con los valores anteriores y nuevos, y los inicios de sesión."
            Breadcrumbs="_breadcrumbs" />

<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" ActivePanelIndexChanged="TabChangedAsync">
    <MudTabPanel Text="Operaciones" Icon="@Icons.Material.Outlined.ManageSearch">
        <Panel Title="Operaciones" Icon="@Icons.Material.Outlined.ManageSearch" Subtitle="Haga clic en un registro para ver el detalle.">
            <div class="list-toolbar">
                <MudTextField @bind-Value="_query.Search" Placeholder="Texto o número del registro"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                              DebounceInterval="400" OnDebounceIntervalElapsed="_ => ReloadAsync()"
                              OnClearButtonClick="_ => FilterAsync(() => _query.Search = null)" MaxLength="100"
                              aria-label="Buscar en la auditoría" Class="list-toolbar__search tl-filter-plain" />
                <MudSelect T="string" Value="_query.Action" ValueChanged="value => FilterAsync(() => _query.Action = value)" Label="Acción"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" Class="list-toolbar__filter">
                    @foreach (string action in _catalogs.Actions)
                    {
                        <MudSelectItem T="string" Value="action">@action</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Value="_query.Entity" ValueChanged="value => FilterAsync(() => _query.Entity = value)" Label="Entidad"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" Class="list-toolbar__filter">
                    @foreach (string entity in _catalogs.Entities)
                    {
                        <MudSelectItem T="string" Value="entity">@entity</MudSelectItem>
                    }
                </MudSelect>
                <div class="list-toolbar__range">
                    <MudDateRangePicker DateRange="_range" DateRangeChanged="value => FilterAsync(() => _range = value)" Label="Fechas" Clearable="true"
                                        MaxDate="DateTime.Today" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </div>
            </div>

            @if (_loading && _page is null)
            {
                <LoadingState />
            }
            else if (_error is not null)
            {
                <ErrorState Title="No fue posible cargar la auditoría" Message="@_error" OnRetry="LoadAsync" />
            }
            else if (_page is { Items.Count: 0 })
            {
                <EmptyState Icon="@Icons.Material.Outlined.ManageSearch" Title="Sin registros" Message="No hay registros con esos filtros." />
            }
            else if (_page is not null)
            {
                <div class="table-scroll">
                    <MudTable Items="_page.Items" Hover="true" Dense="true" Elevation="0" Loading="_loading" Breakpoint="Breakpoint.None"
                              Class="tl-table tl-table--clickable" OnRowClick="@((TableRowClickEventArgs<AuditEntryResponse> args) => ShowAsync(args.Item!))">
                        <HeaderContent>
                            <MudTh>Fecha</MudTh>
                            <MudTh>Usuario</MudTh>
                            <MudTh>Acción</MudTh>
                            <MudTh>Descripción</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Class="cell-nowrap">@context.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                            <MudTd>
                                <div>@(context.UserName ?? "—")</div>
                                <div class="cell-secondary">@context.Employee</div>
                            </MudTd>
                            <MudTd>
                                <div class="cell-primary">@context.Action</div>
                                <div class="cell-secondary">@context.Entity @(context.EntityId is null ? "" : $"#{context.EntityId}")</div>
                            </MudTd>
                            <MudTd>
                                @context.Description
                                @if (context.ChangeCount > 0)
                                {
                                    <div class="cell-secondary">@context.ChangeCount campo(s) con cambios</div>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
                <ListPager Page="_page.Page" PageSize="_page.PageSize" TotalItems="_page.TotalItems" TotalPages="_page.TotalPages" PageChanged="PageChangedAsync" />
            }
        </Panel>
    </MudTabPanel>

    <MudTabPanel Text="Inicios de sesión" Icon="@Icons.Material.Outlined.Login">
        <Panel Title="Inicios de sesión" Icon="@Icons.Material.Outlined.Login" Subtitle="Intentos exitosos y fallidos; nunca se guardan contraseñas.">
            <div class="list-toolbar">
                <MudTextField @bind-Value="_access.UserName" Placeholder="Usuario"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                              DebounceInterval="400" OnDebounceIntervalElapsed="_ => ReloadAccessAsync()"
                              OnClearButtonClick="_ => AccessFilterAsync(() => _access.UserName = null)" MaxLength="100"
                              aria-label="Buscar por usuario" Class="list-toolbar__search tl-filter-username" />
                <MudSelect T="bool?" Value="_access.Succeeded" ValueChanged="value => AccessFilterAsync(() => _access.Succeeded = value)" Label="Resultado"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" Class="list-toolbar__filter">
                    <MudSelectItem T="bool?" Value="true">Exitosos</MudSelectItem>
                    <MudSelectItem T="bool?" Value="false">Fallidos</MudSelectItem>
                </MudSelect>
            </div>

            @if (_accessPage is null)
            {
                <LoadingState />
            }
            else if (_accessPage.Items.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.Login" Title="Sin registros" Message="No hay inicios de sesión con esos filtros." />
            }
            else
            {
                <div class="table-scroll">
                    <MudTable Items="_accessPage.Items" Dense="true" Elevation="0" Breakpoint="Breakpoint.None" Class="tl-table">
                        <HeaderContent>
                            <MudTh>Fecha</MudTh>
                            <MudTh>Usuario</MudTh>
                            <MudTh>Resultado</MudTh>
                            <MudTh Class="col-optional">IP</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Class="cell-nowrap">@context.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</MudTd>
                            <MudTd>@context.UserName</MudTd>
                            <MudTd>
                                <DocumentStatus Code="@(context.Succeeded ? "PROCESADA" : "ANULADA")" Text="@(context.Succeeded ? "Exitoso" : "Fallido")" />
                                @if (context.FailureReason is not null)
                                {
                                    <div class="cell-secondary">@context.FailureReason</div>
                                }
                            </MudTd>
                            <MudTd Class="col-optional">@context.IpAddress</MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
                <ListPager Page="_accessPage.Page" PageSize="_accessPage.PageSize" TotalItems="_accessPage.TotalItems"
                           TotalPages="_accessPage.TotalPages" PageChanged="AccessPageChangedAsync" />
            }
        </Panel>
    </MudTabPanel>
</MudTabs>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Inicio", "/"),
        new("Reportes", null, disabled: true),
        new("Auditoría", null, disabled: true)
    ];

    private readonly AuditQuery _query = new() { PageSize = 20 };
    private readonly AccessLogQuery _access = new() { PageSize = 20 };
    private AuditCatalogsResponse _catalogs = new();
    private PagedResponse<AuditEntryResponse>? _page;
    private PagedResponse<AccessLogResponse>? _accessPage;
    private DateRange? _range;
    private bool _loading;
    private string? _error;
    private CancellationTokenSource? _loadCancellation;

    protected override async Task OnInitializedAsync()
    {
        Task load = LoadAsync();
        _catalogs = (await AuditApi.GetCatalogsAsync()).Data ?? new AuditCatalogsResponse();
        await load;
    }

    private async Task LoadAsync()
    {
        _loadCancellation?.Cancel();
        _loadCancellation = new CancellationTokenSource();
        CancellationToken token = _loadCancellation.Token;
        _loading = true;
        _error = null;

        _query.From = _range?.Start is { } start ? DateOnly.FromDateTime(start) : null;
        _query.To = _range?.End is { } end ? DateOnly.FromDateTime(end) : null;

        ApiResult<PagedResponse<AuditEntryResponse>> result = await AuditApi.GetPagedAsync(_query, token);

        if (token.IsCancellationRequested)
        {
            return;
        }

        _page = result.Data ?? _page;
        _error = result.Succeeded ? null : result.Message;
        _loading = false;
    }

    private Task ReloadAsync()
    {
        _query.Page = 1;
        return LoadAsync();
    }

    private Task FilterAsync(Action change)
    {
        change();
        return ReloadAsync();
    }

    private Task PageChangedAsync(int page)
    {
        _query.Page = page;
        return LoadAsync();
    }

    private async Task TabChangedAsync(int index)
    {
        if (index == 1 && _accessPage is null)
        {
            await LoadAccessAsync();
        }
    }

    private async Task LoadAccessAsync()
    {
        ApiResult<PagedResponse<AccessLogResponse>> result = await AuditApi.GetAccessLogAsync(_access);
        _accessPage = result.Data ?? new PagedResponse<AccessLogResponse>();
    }

    private Task ReloadAccessAsync()
    {
        _access.Page = 1;
        return LoadAccessAsync();
    }

    private Task AccessFilterAsync(Action change)
    {
        change();
        return ReloadAccessAsync();
    }

    private Task AccessPageChangedAsync(int page)
    {
        _access.Page = page;
        return LoadAccessAsync();
    }

    private async Task ShowAsync(AuditEntryResponse entry)
    {
        DialogParameters<AuditDetailDialog> parameters = new() { { dialog => dialog.EntryId, entry.Id } };
        await Dialogs.ShowAsync<AuditDetailDialog>($"{entry.Action} · {entry.Entity}", parameters, DialogExtensions.FormOptions);
    }

    public void Dispose()
    {
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
    }
}
