@page "/reportes/compras"
@attribute [RequirePermission(AppPermissions.ReportsPurchases)]
@using TikalLibros.Application.DTOs.Reports
@using TikalLibros.Web.Services.Reports
@inject ReportsApi ReportsApi
@inject IJSRuntime JS

<PageTitle>Reporte de compras | Tikal Libros</PageTitle>

<PageHeader Title="Compras"
            Description="Mercadería aceptada en recepciones al costo neto (sin IVA), devoluciones al proveedor y órdenes por recibir."
            Breadcrumbs="_breadcrumbs">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Download"
                   Disabled="_report is null" OnClick="ExportAsync">
            Exportar CSV
        </MudButton>
    </Actions>
</PageHeader>

<div class="panel">
    <div class="list-toolbar">
        <div class="list-toolbar__range">
            <MudDateRangePicker DateRange="_range" DateRangeChanged="RangeChangedAsync" Label="Período"
                                MaxDate="DateTime.Today" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <span class="form-hint">Máximo 366 días.</span>
    </div>
</div>

@if (_error is not null)
{
    <div class="panel"><ErrorState Title="No fue posible generar el reporte" Message="@_error" OnRetry="LoadAsync" /></div>
}
else if (_report is null)
{
    <div class="panel"><LoadingState Rows="6" /></div>
}
else
{
    <div class="stat-grid">
        <StatCard Tint="sky" Icon="@Icons.Material.Outlined.MoveToInbox" Label="Comprado" Value="@Money(_report.Total)"
                  Caption="@($"{_report.ReceptionsCount} recepción(es) · {_report.Units:N0} unidades")" />
        <StatCard Tint="peach" Icon="@Icons.Material.Outlined.Outbox" Label="Devuelto al proveedor" Value="@Money(_report.SupplierReturnsTotal)"
                  Caption="@($"{_report.SupplierReturnsCount} devolución(es) · {_report.RejectedUnits:N0} unidades rechazadas")" />
        <StatCard Tint="mint" Icon="@Icons.Material.Outlined.Calculate" Label="Compra neta" Value="@Money(_report.NetTotal)"
                  Caption="@(_report.AnnulledCount > 0 ? $"{_report.AnnulledCount} recepción(es) anulada(s) no suman" : null)" />
        <StatCard Tint="sand" Icon="@Icons.Material.Outlined.PendingActions" Label="Por recibir (a hoy)" Value="@Money(_report.PendingOrdersAmount)"
                  Caption="@($"{_report.PendingOrdersCount} orden(es) emitidas o parciales")" />
    </div>

    <Panel Title="Compras por día" Icon="@Icons.Material.Outlined.BarChart" Subtitle="@($"Del {_report.From:dd/MM/yyyy} al {_report.To:dd/MM/yyyy}")">
        @{ decimal max = _report.ByDay.Select(day => day.Total).DefaultIfEmpty(0).Max(); }
        <div class="day-chart" role="img" aria-label="Total comprado por día">
            @foreach (SalesByDayRow day in _report.ByDay)
            {
                <div class="day-chart__bar" tabindex="0" title="@($"{day.Date:dd/MM/yyyy}: {Money(day.Total)} en {day.Count} recepción(es)")"
                     style="@($"height: {(max == 0 ? 0 : day.Total / max * 100):0.#}%")"></div>
            }
        </div>
        <div class="day-chart__axis"><span>@_report.From.ToString("dd/MM")</span><span>@_report.To.ToString("dd/MM")</span></div>
    </Panel>

    <div class="layout-split">
        <Panel Title="Por proveedor" Icon="@Icons.Material.Outlined.LocalShipping">
            <BarList Rows="_report.BySupplier" EmptyMessage="No hay recepciones en el período." />
        </Panel>
        <Panel Title="Libros más comprados" Icon="@Icons.Material.Outlined.MenuBook" Subtitle="Por monto.">
            @if (_report.TopBooks.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.MenuBook" Title="Sin compras" Message="No hay recepciones en el período." />
            }
            else
            {
                <div class="table-scroll">
                    <MudSimpleTable Dense="true" Elevation="0" Class="tl-table">
                        <thead><tr><th>Libro</th><th class="text-right">Unidades</th><th class="text-right">Total</th></tr></thead>
                        <tbody>
                            @foreach (PurchasedBookRow row in _report.TopBooks)
                            {
                                <tr>
                                    <td><div class="cell-primary">@row.Title</div><div class="cell-secondary">@row.BookCode</div></td>
                                    <td class="number">@row.Units.ToString("N0")</td>
                                    <td class="number">@row.Total.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            }
        </Panel>
    </div>
}

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Inicio", "/"),
        new("Reportes", null, disabled: true),
        new("Compras", null, disabled: true)
    ];

    private DateRange _range = new(DateTime.Today.AddDays(-29), DateTime.Today);
    private PurchasesReportResponse? _report;
    private string? _error;

    private static string Money(decimal value) => $"Q {value:N2}";

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task RangeChangedAsync(DateRange? range)
    {
        _range = range ?? new DateRange(DateTime.Today.AddDays(-29), DateTime.Today);
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        ApiResult<PurchasesReportResponse> result = await ReportsApi.GetPurchasesAsync(new ReportPeriodQuery
        {
            From = _range.Start is { } start ? DateOnly.FromDateTime(start) : null,
            To = _range.End is { } end ? DateOnly.FromDateTime(end) : null
        });

        _report = result.Data;
        _error = result.Succeeded ? null : result.Message;
    }

    private async Task ExportAsync()
    {
        string csv = CsvExport.Build(
            ["Proveedor", "Recepciones", "Total"],
            _report!.BySupplier.Select(row => new object?[] { row.Name, row.Count, row.Total }));

        await CsvExport.DownloadAsync(JS, $"compras-{_report.From:yyyyMMdd}-{_report.To:yyyyMMdd}.csv", csv);
    }
}
