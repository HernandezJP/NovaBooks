@page "/reportes/caja"
@attribute [RequirePermission(AppPermissions.ReportsCash)]
@using TikalLibros.Application.DTOs.Reports
@using TikalLibros.Web.Services.Reports
@inject ReportsApi ReportsApi

<PageTitle>Reporte de caja | Tikal Libros</PageTitle>

<PageHeader Title="Caja"
            Description="Aperturas del período con su cuadre (faltantes y sobrantes) y movimientos por tipo y método de pago."
            Breadcrumbs="_breadcrumbs">
    <Actions>
        <ExportActions Build="BuildExportAsync" Disabled="_report is null" />
    </Actions>
</PageHeader>

<div class="panel">
    <div class="list-toolbar">
        <div class="list-toolbar__range">
            <MudDateRangePicker DateRange="_range" DateRangeChanged="RangeChangedAsync" Label="Período"
                                MaxDate="DateTime.Today" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <span class="form-hint">Máximo 366 días.</span>
    </div>
</div>

@if (_error is not null)
{
    <div class="panel"><ErrorState Title="No fue posible generar el reporte" Message="@_error" OnRetry="LoadAsync" /></div>
}
else if (_report is null)
{
    <div class="panel"><LoadingState Rows="6" /></div>
}
else
{
    <div class="stat-grid">
        <StatCard Tint="sky" Icon="@Icons.Material.Outlined.PointOfSale" Label="Aperturas" Value="@_report.SessionsCount.ToString("N0")"
                  Caption="@(_report.OpenSessions > 0 ? $"{_report.OpenSessions} todavía abierta(s)" : "todas cerradas")" />
        <StatCard Tint="mint" Icon="@Icons.Material.Outlined.SouthWest" Label="Ingresos" Value="@Money(_report.Income)" />
        <StatCard Tint="peach" Icon="@Icons.Material.Outlined.NorthEast" Label="Egresos" Value="@Money(_report.Expense)" />
        <StatCard Tint="sand" Icon="@Icons.Material.Outlined.Balance" Label="Faltantes / sobrantes" Value="@($"{Money(_report.Shortages)} / {Money(_report.Overages)}")" />
    </div>

    <div class="layout-split">
        <Panel Title="Por tipo de movimiento" Icon="@Icons.Material.Outlined.SwapVert">
            @if (_report.ByType.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.SwapVert" Title="Sin movimientos" Message="No hay movimientos en el período." />
            }
            else
            {
                <MudSimpleTable Dense="true" Elevation="0" Class="tl-table">
                    <thead><tr><th>Tipo</th><th class="text-right">Cantidad</th><th class="text-right">Monto</th></tr></thead>
                    <tbody>
                        @foreach (CashTypeRow row in _report.ByType)
                        {
                            <tr>
                                <td>@row.Name</td>
                                <td class="number">@row.Count</td>
                                <td class="@($"number {(row.Nature > 0 ? "qty-in" : "qty-out")}")">@((row.Nature > 0 ? "+ " : "− ") + row.Total.ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </Panel>
        <Panel Title="Neto por método de pago" Icon="@Icons.Material.Outlined.CreditCard">
            <BarList Rows="_report.ByMethod" EmptyMessage="No hay movimientos en el período." />
        </Panel>
    </div>

    <Panel Title="Aperturas y cierres" Icon="@Icons.Material.Outlined.History">
        @if (_report.Sessions.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.History" Title="Sin aperturas" Message="No se abrió ninguna caja en el período." />
        }
        else
        {
            <div class="table-scroll">
                <MudSimpleTable Dense="true" Elevation="0" Class="tl-table">
                    <thead>
                        <tr>
                            <th>Caja</th><th>Cajero</th><th>Apertura</th><th>Cierre</th>
                            <th class="text-right">Inicial</th><th class="text-right">Esperado</th><th class="text-right">Contado</th><th class="text-right">Diferencia</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (CashSessionReportRow row in _report.Sessions)
                        {
                            <tr>
                                <td><div class="cell-primary"><a href="@($"/caja/aperturas/{row.Id}")">@row.CashRegister</a></div><div class="cell-secondary">@row.Branch</div></td>
                                <td>@row.Employee</td>
                                <td class="cell-nowrap">@row.OpenedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="cell-nowrap">@(row.IsOpen ? "Abierta" : row.ClosedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</td>
                                <td class="number">@row.InitialAmount.ToString("N2")</td>
                                <td class="number">@(row.Expected?.ToString("N2") ?? "—")</td>
                                <td class="number">@(row.Counted?.ToString("N2") ?? "—")</td>
                                <td class="@($"number {(row.Difference < 0 ? "qty-out" : row.Difference > 0 ? "qty-in" : string.Empty)}")">@(row.Difference?.ToString("N2") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
    </Panel>
}

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Inicio", "/"),
        new("Reportes", null, disabled: true),
        new("Caja", null, disabled: true)
    ];

    private DateRange _range = new(DateTime.Today.AddDays(-29), DateTime.Today);
    private CashReportResponse? _report;
    private string? _error;

    private static string Money(decimal value) => $"Q {value:N2}";

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task RangeChangedAsync(DateRange? range)
    {
        _range = range ?? new DateRange(DateTime.Today.AddDays(-29), DateTime.Today);
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        ApiResult<CashReportResponse> result = await ReportsApi.GetCashAsync(new ReportPeriodQuery
        {
            From = _range.Start is { } start ? DateOnly.FromDateTime(start) : null,
            To = _range.End is { } end ? DateOnly.FromDateTime(end) : null
        });

        _report = result.Data;
        _error = result.Succeeded ? null : result.Message;
    }

    private Task<ExportTable?> BuildExportAsync() => Task.FromResult<ExportTable?>(new ExportTable(
        $"caja-{_report!.From:yyyyMMdd}-{_report.To:yyyyMMdd}", "Aperturas y cierres de caja", $"Del {_report.From:dd/MM/yyyy} al {_report.To:dd/MM/yyyy}",
        [
            new("Caja"), new("Sucursal"), new("Cajero"), new("Apertura", ExportKind.DateTime), new("Cierre", ExportKind.DateTime),
            new("Inicial", ExportKind.Money), new("Esperado", ExportKind.Money), new("Contado", ExportKind.Money), new("Diferencia", ExportKind.Money)
        ],
        _report.Sessions.Select(row => new object?[]
        {
            row.CashRegister, row.Branch, row.Employee, row.OpenedAt, row.ClosedAt, row.InitialAmount, row.Expected, row.Counted, row.Difference
        }).ToList()));
}
