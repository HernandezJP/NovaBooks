@page "/reportes/ventas"
@attribute [RequirePermission(AppPermissions.ReportsSales)]
@using TikalLibros.Application.DTOs.Reports
@using TikalLibros.Web.Services.Reports
@inject ReportsApi ReportsApi
@inject IJSRuntime JS

<PageTitle>Ventas por período | Tikal Libros</PageTitle>

<PageHeader Title="Ventas por período"
            Description="Totales del período sin ventas anuladas: por día, vendedor, método de pago y condición. La venta neta descuenta las devoluciones."
            Breadcrumbs="_breadcrumbs">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Download"
                   Disabled="_report is null" OnClick="ExportAsync">
            Exportar CSV
        </MudButton>
    </Actions>
</PageHeader>

<div class="panel">
    <div class="list-toolbar">
        <div class="list-toolbar__range">
            <MudDateRangePicker DateRange="_range" DateRangeChanged="RangeChangedAsync" Label="Período"
                                MaxDate="DateTime.Today" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <span class="form-hint">Máximo 366 días.</span>
    </div>
</div>

@if (_error is not null)
{
    <div class="panel"><ErrorState Title="No fue posible generar el reporte" Message="@_error" OnRetry="LoadAsync" /></div>
}
else if (_report is null)
{
    <div class="panel"><LoadingState Rows="6" /></div>
}
else
{
    <div class="stat-grid">
        <StatCard Tint="sky" Icon="@Icons.Material.Outlined.ReceiptLong" Label="Ventas" Value="@_report.SalesCount.ToString("N0")"
                  Caption="@(_report.AnnulledCount > 0 ? $"{_report.AnnulledCount} anulada(s) no suman" : null)" />
        <StatCard Tint="mint" Icon="@Icons.Material.Outlined.Payments" Label="Total vendido" Value="@Money(_report.Total)"
                  Caption="@($"{_report.Units:N0} unidades · IVA {Money(_report.Tax)}")" />
        <StatCard Tint="sand" Icon="@Icons.Material.Outlined.Receipt" Label="Ticket promedio" Value="@Money(_report.AverageTicket)"
                  Caption="@($"Descuentos {Money(_report.Discount)}")" />
        <StatCard Tint="peach" Icon="@Icons.Material.Outlined.HourglassBottom" Label="Pendiente de cobro" Value="@Money(_report.Pending)"
                  Caption="@($"Cobrado {Money(_report.Collected)}")" />
        <StatCard Tint="sky" Icon="@Icons.Material.Outlined.AssignmentReturn" Label="Venta neta" Value="@Money(_report.NetTotal)"
                  Caption="@($"{_report.ReturnsCount} devolución(es) por {Money(_report.Returned)}")" />
    </div>

    <Panel Title="Ventas por día" Icon="@Icons.Material.Outlined.BarChart"
           Subtitle="@($"Del {_report.From:dd/MM/yyyy} al {_report.To:dd/MM/yyyy}")">
        @{ decimal max = _report.ByDay.Select(day => day.Total).DefaultIfEmpty(0).Max(); }
        <div class="day-chart" role="img" aria-label="Total vendido por día">
            @foreach (SalesByDayRow day in _report.ByDay)
            {
                <div class="day-chart__bar" tabindex="0" title="@($"{day.Date:dd/MM/yyyy}: {Money(day.Total)} en {day.Count} venta(s)")"
                     style="@($"height: {(max == 0 ? 0 : day.Total / max * 100):0.#}%")"></div>
            }
        </div>
        <div class="day-chart__axis"><span>@_report.From.ToString("dd/MM")</span><span>@_report.To.ToString("dd/MM")</span></div>
    </Panel>

    <div class="layout-split">
        <Panel Title="Por vendedor" Icon="@Icons.Material.Outlined.Badge">@Bars(_report.ByEmployee)</Panel>
        <Panel Title="Cobros por método de pago" Icon="@Icons.Material.Outlined.CreditCard">@Bars(_report.ByPaymentMethod)</Panel>
    </div>

    <Panel Title="Por condición de pago" Icon="@Icons.Material.Outlined.Handshake">@Bars(_report.BySaleType)</Panel>
}

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Inicio", "/"),
        new("Reportes", null, disabled: true),
        new("Ventas por período", null, disabled: true)
    ];

    private DateRange _range = new(DateTime.Today.AddDays(-29), DateTime.Today);
    private SalesReportResponse? _report;
    private string? _error;

    private static string Money(decimal value) => $"Q {value:N2}";

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task RangeChangedAsync(DateRange? range)
    {
        _range = range ?? new DateRange(DateTime.Today.AddDays(-29), DateTime.Today);
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        ApiResult<SalesReportResponse> result = await ReportsApi.GetSalesAsync(new ReportPeriodQuery
        {
            From = _range.Start is { } start ? DateOnly.FromDateTime(start) : null,
            To = _range.End is { } end ? DateOnly.FromDateTime(end) : null
        });

        _report = result.Data;
        _error = result.Succeeded ? null : result.Message;
    }

    private async Task ExportAsync()
    {
        string csv = CsvExport.Build(
            ["Fecha", "Ventas", "Total"],
            _report!.ByDay.Select(day => new object?[] { day.Date, day.Count, day.Total }));

        await CsvExport.DownloadAsync(JS, $"ventas-{_report.From:yyyyMMdd}-{_report.To:yyyyMMdd}.csv", csv);
    }

    private static RenderFragment Bars(IReadOnlyCollection<SalesByGroupRow> rows) => __builder =>
    {
        if (rows.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.BarChart" Title="Sin datos" Message="No hay ventas en el período." />
            return;
        }

        decimal max = rows.Max(row => row.Total);

        <ul class="bar-list">
            @foreach (SalesByGroupRow row in rows)
            {
                <li class="bar-list__row">
                    <span class="bar-list__label" title="@row.Name">@row.Name</span>
                    <span class="bar-list__track"><span class="bar-list__fill" style="@($"display:block;width: {(max == 0 ? 0 : row.Total / max * 100):0.#}%")"></span></span>
                    <span class="bar-list__value">@Money(row.Total) · @row.Count</span>
                </li>
            }
        </ul>
    };
}
