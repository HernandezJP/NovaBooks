@page "/reportes/inventario"
@attribute [RequirePermission(AppPermissions.ReportsInventory)]
@using TikalLibros.Application.DTOs.Inventory
@using TikalLibros.Application.DTOs.Reports
@using TikalLibros.Web.Services.Reports
@inject ReportsApi ReportsApi

<PageTitle>Inventario valorizado | Tikal Libros</PageTitle>

<PageHeader Title="Inventario valorizado"
            Description="Existencia por libro y almacén valorizada al costo promedio de sus lotes vigentes."
            Breadcrumbs="_breadcrumbs">
    <Actions>
        <ExportActions Build="BuildExportAsync" Disabled="@(_report is not { Rows.Count: > 0 })" />
    </Actions>
</PageHeader>

<div class="panel">
    <div class="list-toolbar">
        <MudTextField @bind-Value="_query.Search" Placeholder="Título o código"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                      DebounceInterval="400" OnDebounceIntervalElapsed="_ => LoadAsync()"
                      OnClearButtonClick="_ => ChangeAsync(() => _query.Search = null)" MaxLength="100"
                      aria-label="Buscar libros" Class="list-toolbar__search tl-filter-plain" />
        <MudSelect T="string" Value="_query.Status" ValueChanged="value => ChangeAsync(() => _query.Status = value)" Label="Estado"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="list-toolbar__filter">
            <MudSelectItem T="string" Value="@string.Empty">Todos</MudSelectItem>
            @foreach (string status in new[] { StockStatus.OutOfStock, StockStatus.BelowMinimum, StockStatus.AboveMaximum, StockStatus.Normal })
            {
                <MudSelectItem T="string" Value="status">@StockStatus.Label(status)</MudSelectItem>
            }
        </MudSelect>
        <MudCheckBox T="bool" Value="_query.OnlyWithStock" ValueChanged="value => ChangeAsync(() => _query.OnlyWithStock = value)"
                     Label="Solo con existencia" Dense="true" Color="Color.Primary" />
    </div>
</div>

@if (_error is not null)
{
    <div class="panel"><ErrorState Title="No fue posible generar el reporte" Message="@_error" OnRetry="LoadAsync" /></div>
}
else if (_report is null)
{
    <div class="panel"><LoadingState Rows="6" /></div>
}
else
{
    <div class="stat-grid">
        <StatCard Tint="mint" Icon="@Icons.Material.Outlined.AccountBalanceWallet" Label="Valor del inventario" Value="@($"Q {_report.TotalValue:N2}")" />
        <StatCard Tint="sky" Icon="@Icons.Material.Outlined.Inventory2" Label="Unidades" Value="@_report.TotalUnits.ToString("N0")"
                  Caption="@($"{_report.Titles:N0} título(s)")" />
        <StatCard Tint="peach" Icon="@Icons.Material.Outlined.ProductionQuantityLimits" Label="Agotados" Value="@_report.OutOfStock.ToString("N0")" />
        <StatCard Tint="sand" Icon="@Icons.Material.Outlined.NotificationImportant" Label="Bajo mínimo" Value="@_report.BelowMinimum.ToString("N0")" />
    </div>

    <Panel Title="Existencias" Icon="@Icons.Material.Outlined.Warehouse"
           Subtitle="@($"Generado el {_report.GeneratedAt.ToLocalTime():dd/MM/yyyy HH:mm}")">
        @if (_report.Truncated)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                Se muestran las primeras @InventoryValuationResponse.MaxRows.ToString("N0") filas; use los filtros para acotar.
            </MudAlert>
        }
        @if (_report.Rows.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Warehouse" Title="Sin existencias" Message="No hay existencias con esos filtros." />
        }
        else
        {
            <div class="table-scroll">
                <MudTable Items="_report.Rows" Dense="true" Elevation="0" Breakpoint="Breakpoint.None" Class="tl-table" RowsPerPage="25">
                    <HeaderContent>
                        <MudTh>Libro</MudTh>
                        <MudTh Class="col-optional">Almacén</MudTh>
                        <MudTh Class="text-right">Disponible</MudTh>
                        <MudTh Class="text-right col-optional">Reservado</MudTh>
                        <MudTh Class="text-right col-optional">Costo prom.</MudTh>
                        <MudTh Class="text-right">Valor</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div class="cell-primary">@context.Title</div>
                            <div class="cell-secondary">@context.BookCode · <DocumentStatus Code="@context.Status" Text="@context.StatusLabel" /></div>
                        </MudTd>
                        <MudTd Class="col-optional">@context.Warehouse</MudTd>
                        <MudTd Class="number">@context.Available.ToString("N0")</MudTd>
                        <MudTd Class="number col-optional">@context.Reserved.ToString("N0")</MudTd>
                        <MudTd Class="number col-optional">@context.AverageCost.ToString("N2")</MudTd>
                        <MudTd Class="number">@context.Value.ToString("N2")</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" RowsPerPageString="Filas por página" InfoFormat="{first_item}–{last_item} de {all_items}" />
                    </PagerContent>
                </MudTable>
            </div>
        }
    </Panel>
}

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Inicio", "/"),
        new("Reportes", null, disabled: true),
        new("Inventario valorizado", null, disabled: true)
    ];

    private readonly InventoryValuationQuery _query = new() { Status = string.Empty };
    private InventoryValuationResponse? _report;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task ChangeAsync(Action change)
    {
        change();
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        ApiResult<InventoryValuationResponse> result = await ReportsApi.GetInventoryValuationAsync(_query);
        _report = result.Data;
        _error = result.Succeeded ? null : result.Message;
    }

    private Task<ExportTable?> BuildExportAsync() => Task.FromResult<ExportTable?>(new ExportTable(
        $"inventario-valorizado-{DateTime.Today:yyyyMMdd}", "Inventario valorizado", $"Existencias al {DateTime.Now:dd/MM/yyyy HH:mm}",
        [
            new("Código"), new("Título"), new("Almacén"), new("Disponible", ExportKind.Number), new("Reservado", ExportKind.Number),
            new("Libre", ExportKind.Number), new("Mínimo", ExportKind.Number), new("Costo promedio", ExportKind.Money),
            new("Valor", ExportKind.Money), new("Estado")
        ],
        _report!.Rows.Select(row => new object?[]
        {
            row.BookCode, row.Title, row.Warehouse, row.Available, row.Reserved, row.Free, row.Minimum, row.AverageCost, row.Value, row.StatusLabel
        }).ToList()));
}
