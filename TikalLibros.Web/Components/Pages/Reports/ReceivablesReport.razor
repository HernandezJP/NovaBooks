@page "/reportes/cuentas-por-cobrar"
@attribute [RequirePermission(AppPermissions.ReportsSales)]
@using TikalLibros.Application.DTOs.Reports
@using TikalLibros.Web.Services.Reports
@inject ReportsApi ReportsApi
@inject IJSRuntime JS

<PageTitle>Cuentas por cobrar | Tikal Libros</PageTitle>

<PageHeader Title="Cuentas por cobrar"
            Description="Saldos de ventas al crédito a la fecha, por antigüedad de vencimiento y por cliente."
            Breadcrumbs="_breadcrumbs">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Download"
                   Disabled="_report is null" OnClick="ExportAsync">
            Exportar CSV
        </MudButton>
    </Actions>
</PageHeader>

<div class="panel">
    <div class="list-toolbar">
        <MudSwitch T="bool" Value="_onlyOverdue" ValueChanged="OverdueChangedAsync" Color="Color.Primary" Label="Solo vencidas" />
    </div>
</div>

@if (_error is not null)
{
    <div class="panel"><ErrorState Title="No fue posible generar el reporte" Message="@_error" OnRetry="LoadAsync" /></div>
}
else if (_report is null)
{
    <div class="panel"><LoadingState Rows="6" /></div>
}
else
{
    <div class="stat-grid">
        <StatCard Tint="sky" Icon="@Icons.Material.Outlined.AccountBalanceWallet" Label="Por cobrar" Value="@Money(_report.Total)"
                  Caption="@($"{_report.SalesCount} venta(s) de {_report.CustomersCount} cliente(s)")" />
        <StatCard Tint="peach" Icon="@Icons.Material.Outlined.EventBusy" Label="Vencido" Value="@Money(_report.Overdue)"
                  Caption="@($"al {_report.AsOf:dd/MM/yyyy}")" />
    </div>

    <div class="layout-split">
        <Panel Title="Antigüedad de saldos" Icon="@Icons.Material.Outlined.HourglassBottom" Subtitle="Días desde el vencimiento del crédito.">
            <BarList Rows="_report.Buckets" EmptyMessage="No hay saldos pendientes." />
        </Panel>
        <Panel Title="Por cliente" Icon="@Icons.Material.Outlined.Badge">
            @if (_report.Customers.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.Badge" Title="Sin saldos" Message="Ningún cliente tiene saldo pendiente." />
            }
            else
            {
                <div class="table-scroll">
                    <MudSimpleTable Dense="true" Elevation="0" Class="tl-table">
                        <thead><tr><th>Cliente</th><th class="text-right">Ventas</th><th class="text-right">Saldo</th><th class="text-right">Vencido</th><th class="text-right col-optional">Límite</th></tr></thead>
                        <tbody>
                            @foreach (ReceivableCustomerRow row in _report.Customers)
                            {
                                <tr>
                                    <td>
                                        <div class="cell-primary">@row.Customer</div>
                                        @if (row.MaxDaysOverdue > 0)
                                        {
                                            <div class="cell-secondary qty-out">@row.MaxDaysOverdue días de atraso</div>
                                        }
                                    </td>
                                    <td class="number">@row.Sales</td>
                                    <td class="number">@row.Balance.ToString("N2")</td>
                                    <td class="number">@row.Overdue.ToString("N2")</td>
                                    <td class="number col-optional">@row.CreditLimit.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            }
        </Panel>
    </div>

    <Panel Title="Ventas con saldo" Icon="@Icons.Material.Outlined.ReceiptLong" Subtitle="Las más atrasadas primero.">
        @if (_report.Sales.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.ReceiptLong" Title="Sin saldos" Message="No hay ventas con saldo pendiente." />
        }
        else
        {
            <div class="table-scroll">
                <MudSimpleTable Dense="true" Elevation="0" Class="tl-table">
                    <thead>
                        <tr><th>Venta</th><th>Cliente</th><th>Vence</th><th class="text-right">Total</th><th class="text-right">Pagado</th><th class="text-right">Saldo</th><th>Antigüedad</th></tr>
                    </thead>
                    <tbody>
                        @foreach (ReceivableSaleRow row in _report.Sales)
                        {
                            <tr>
                                <td>
                                    <div class="cell-primary"><a href="@($"/ventas/{row.SaleId}")">@row.Number</a></div>
                                    <div class="cell-secondary">@row.Date.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>@row.Customer</td>
                                <td class="cell-nowrap">@row.DueDate.ToString("dd/MM/yyyy")</td>
                                <td class="number">@row.Total.ToString("N2")</td>
                                <td class="number">@row.Paid.ToString("N2")</td>
                                <td class="number">@row.Balance.ToString("N2")</td>
                                <td>
                                    <DocumentStatus Code="@(row.DaysOverdue == 0 ? "NORMAL" : row.DaysOverdue > 60 ? "VENCIDO" : "PARCIAL")"
                                                    Text="@(row.DaysOverdue == 0 ? row.Bucket : $"{row.DaysOverdue} días")" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
    </Panel>
}

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Inicio", "/"),
        new("Reportes", null, disabled: true),
        new("Cuentas por cobrar", null, disabled: true)
    ];

    private ReceivablesResponse? _report;
    private bool _onlyOverdue;
    private string? _error;

    private static string Money(decimal value) => $"Q {value:N2}";

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task OverdueChangedAsync(bool value)
    {
        _onlyOverdue = value;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        ApiResult<ReceivablesResponse> result = await ReportsApi.GetReceivablesAsync(new ReceivablesQuery { OnlyOverdue = _onlyOverdue });
        _report = result.Data;
        _error = result.Succeeded ? null : result.Message;
    }

    private async Task ExportAsync()
    {
        string csv = CsvExport.Build(
            ["Venta", "Fecha", "Cliente", "Vence", "Total", "Pagado", "Saldo", "Días de atraso", "Antigüedad"],
            _report!.Sales.Select(row => new object?[]
            {
                row.Number, DateOnly.FromDateTime(row.Date.ToLocalTime()), row.Customer, row.DueDate,
                row.Total, row.Paid, row.Balance, row.DaysOverdue, row.Bucket
            }));

        await CsvExport.DownloadAsync(JS, $"cuentas-por-cobrar-{_report.AsOf:yyyyMMdd}.csv", csv);
    }
}
