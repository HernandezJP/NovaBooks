<PageTitle>Acceso denegado | Tikal Libros</PageTitle>

<div class="access-denied">
    <MudPaper Class="access-denied__card" Elevation="0">
        <MudIcon Icon="@Icons.Material.Outlined.Lock" Color="Color.Error" Size="Size.Large" />
        <MudText Typo="Typo.h5" HtmlTag="h1" Class="mt-3">Acceso denegado</MudText>
        <MudText Typo="Typo.body1" HtmlTag="p" Color="Color.Secondary" Class="mt-1">
            No tiene permiso para ver esta página. Solicite acceso a un administrador.
        </MudText>
        @if (!string.IsNullOrEmpty(Permission))
        {
            <p class="access-denied__permission">
                Permiso requerido: <strong>@PermissionLabel</strong>
            </p>
        }
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-5"
                   StartIcon="@Icons.Material.Filled.Home">
            Ir al inicio
        </MudButton>
    </MudPaper>
</div>

@code {
    [Parameter]
    public string? Permission { get; set; }

    // "Catalogo.Ver" -> "Catálogo › Ver"
    private string PermissionLabel =>
        string.Join(" › ", Permission!.Split('.').Select(PermissionLabels.Humanize));
}
