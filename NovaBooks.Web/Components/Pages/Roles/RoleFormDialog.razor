@using NovaBooks.Application.DTOs.Roles
@inject RolesApi RolesApi

<MudDialog>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="SaveAsync" OnInvalidSubmit="OnInvalidSubmit" id="role-form">
            <DataAnnotationsValidator />
            <ServerValidator Result="_saveResult" />
            <FormErrors Result="_saveResult" ShowInvalidHint="_showInvalid" />
                <p class="required-legend">Los campos con <span aria-hidden="true">*</span> son obligatorios.</p>

            @if (Role?.IsProtected == true)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    El rol Administrador no puede renombrarse; solo puede editar su descripción.
                </MudAlert>
            }

            <MudTextField @bind-Value="_model.Name" For="@(() => _model.Name)"
                          Label="Nombre del rol *" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Disabled="@(Role?.IsProtected == true)" Class="mb-3" />

            <MudTextField @bind-Value="_model.Description" For="@(() => _model.Description)"
                          Label="Descripción" Counter="500" MaxLength="500" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_saving">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit"
                   form="role-form" Disabled="_saving">
            @if (_saving)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            }
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>Rol a editar; null para crear.</summary>
    [Parameter]
    public RoleResponse? Role { get; set; }

    private readonly CreateRoleRequest _model = new();
    private bool _saving;
    private bool _showInvalid;
    private IApiResultView? _saveResult;

    protected override void OnInitialized()
    {
        if (Role is not null)
        {
            _model.Name = Role.Name;
            _model.Description = Role.Description;
        }
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _showInvalid = false;
        _saveResult = null;

        try
        {
            ApiResult<RoleResponse> result = Role is null
                ? await RolesApi.CreateAsync(_model)
                : await RolesApi.UpdateAsync(Role.Id, new UpdateRoleRequest
                {
                    Name = _model.Name,
                    Description = _model.Description
                });

            if (result.Succeeded)
            {
                Dialog.Close(DialogResult.Ok(result.Data));
                return;
            }

            _saveResult = result;
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => Dialog.Cancel();

    private void OnInvalidSubmit()
    {
        _showInvalid = true;
        _saveResult = null;
    }
}
