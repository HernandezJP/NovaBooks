@page "/Error"
@layout AuthLayout
@attribute [AllowAnonymousPage]
@attribute [ExcludeFromInteractiveRouting]
@using System.Diagnostics

<PageTitle>Error | NovaBooks</PageTitle>

<div class="access-denied">
    <div class="access-denied__card">
        <h1 class="h4">Ocurrió un error</h1>
        <p>No fue posible procesar la solicitud. Intente nuevamente.</p>

        @if (ShowRequestId)
        {
            <p class="small text-muted">
                Identificador de la solicitud: <code>@RequestId</code>
            </p>
        }

        <a href="/" class="btn btn-primary">Ir al inicio</a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
