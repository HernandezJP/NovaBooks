@using System.ComponentModel.DataAnnotations
@using NovaBooks.Application.DTOs.Users
@inject UsersApi UsersApi

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Defina una nueva contraseña para <strong>@User.UserName</strong>.
            Sus sesiones abiertas se cerrarán y se quitará el bloqueo temporal si lo tiene.
        </MudText>

        <EditForm Model="_model" OnValidSubmit="SaveAsync" OnInvalidSubmit="OnInvalidSubmit" id="reset-password-form">
            <DataAnnotationsValidator />
            <ServerValidator Result="_saveResult" />
            <FormErrors Result="_saveResult" ShowInvalidHint="_showInvalid" />
                <p class="required-legend">Los campos con <span aria-hidden="true">*</span> son obligatorios.</p>

            <MudTextField @bind-Value="_model.NewPassword" For="@(() => _model.NewPassword)"
                          Label="Nueva contraseña *"
                          HelperText="Mínimo 8 caracteres con mayúscula, minúscula, número y símbolo."
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                          AdornmentAriaLabel="Mostrar u ocultar contraseña"
                          OnAdornmentClick="TogglePassword"
                          UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

            <MudTextField @bind-Value="_model.ConfirmPassword" For="@(() => _model.ConfirmPassword)"
                          Label="Confirmar contraseña *"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_saving">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit"
                   form="reset-password-form" Disabled="_saving">
            @if (_saving)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            }
            Restablecer
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public UserResponse User { get; set; } = default!;

    private readonly PasswordModel _model = new();
    private bool _showPassword;
    private bool _saving;
    private bool _showInvalid;
    private IApiResultView? _saveResult;

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _showInvalid = false;
        _saveResult = null;

        try
        {
            ApiResult<bool> result = await UsersApi.ResetPasswordAsync(User.Id, _model.NewPassword);

            if (result.Succeeded)
            {
                Dialog.Close(DialogResult.Ok<bool?>(true));
                return;
            }

            _saveResult = result;
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => Dialog.Cancel();

    private void TogglePassword() => _showPassword = !_showPassword;

    private sealed class PasswordModel
    {
        [Required(ErrorMessage = "La nueva contraseña es obligatoria.")]
        [StringLength(100, MinimumLength = 8,
            ErrorMessage = "La contraseña debe contener entre 8 y 100 caracteres.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirme la contraseña.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private void OnInvalidSubmit()
    {
        _showInvalid = true;
        _saveResult = null;
    }
}
