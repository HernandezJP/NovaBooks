@page "/not-found"
@attribute [AllowAnonymousPage]

<PageTitle>Página no encontrada | NovaBooks</PageTitle>

<div class="access-denied">
    <MudPaper Class="access-denied__card" Elevation="0">
        <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h5" HtmlTag="h1" Class="mt-3">Página no encontrada</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-1">
            La dirección que buscó no existe.
        </MudText>
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                   StartIcon="@Icons.Material.Filled.Home">
            Ir al inicio
        </MudButton>
    </MudPaper>
</div>
